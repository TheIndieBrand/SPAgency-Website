---
import "../styles/global.css";
import ScrollbarOverlay from "../components/ScrollbarOverlay.astro";
import { site } from "../lib/site";

interface Props {
	title?: string;
	description?: string;
	// Scrollbar propia que aparece al hacer scroll o acercar el ratón al borde. El
	// home la desactiva: allí no hay ninguna (ver index.astro).
	customScrollbar?: boolean;
}

const {
	title = site.title,
	description = site.description,
	customScrollbar = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
		{
			customScrollbar && (
				<script is:inline>
					if (matchMedia("(hover: hover) and (pointer: fine)").matches) document.documentElement.setAttribute("data-overlay-scroll", "");
				</script>
			)
		}
		<meta name="description" content={description} />
		<meta name="theme-color" content="#191919" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
		<!-- Fuentes autoalojadas (ver styles/fonts.css). Se precargan solo los subconjuntos
		     "latin", que es lo que usa el texto de la parte visible. -->
		<link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body class="bg-bg text-text font-sans antialiased overflow-x-hidden">
		<slot />
		{customScrollbar && <ScrollbarOverlay />}
	</body>
</html>
