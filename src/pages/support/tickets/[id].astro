---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import { getSessionUser } from "../../../lib/session";
import { listOpenTickets } from "../../../lib/support-bot";
import { supportTranscriptRepository } from "../../../lib/SupportTranscriptRepository";

const id = Astro.params.id ?? "";

const user = await getSessionUser(Astro.cookies);
if (!user) return Astro.redirect(`/auth/discord/login?next=${encodeURIComponent(Astro.url.pathname)}`);

const result = await listOpenTickets(user.id);
if (!result.ok) return Astro.redirect("/support");

const ticket = result.data.tickets.find((t) => t.ticketId === id);
if (!ticket) {
	// Ya cerrado → su transcript; si no es suyo o no existe → al inicio de soporte.
	return Astro.redirect(supportTranscriptRepository.getTranscript(id, user.id) ? `/support/history/${encodeURIComponent(id)}` : "/support");
}
---

<Layout title={`${ticket.subject} — Soporte — SP Agency`}>
	<Navbar />

	<main id="chat" data-ticket={id} class="mx-auto max-w-[720px] px-4 pt-10 pb-6 sm:px-8">
		<a
			href="/support"
			class="text-text-dim hover:text-brand mb-8 inline-flex items-center gap-2 text-sm font-semibold transition-colors"
		>
			<i class="bi bi-arrow-left" />
			Soporte
		</a>

		<header class="border-border-soft mb-2 flex flex-wrap items-start justify-between gap-4 border-b pb-6">
			<div class="min-w-0">
				<div class="text-text-faint mb-2 text-[13px] font-bold tracking-[0.08em] uppercase">Ticket abierto</div>
				<h1 class="font-display text-[28px] leading-tight font-bold tracking-tight sm:text-[32px]">
					{ticket.subject}
				</h1>
			</div>
			<button
				id="close-ticket"
				type="button"
				class="border-border text-text-dim rounded-lg border px-4 py-2 text-sm font-bold transition-colors hover:border-red-500/60 hover:text-red-400 disabled:opacity-60"
			>
				Cerrar ticket
			</button>
		</header>

		<div id="messages" aria-live="polite" class="min-h-[240px]"></div>
		<p id="empty" class="text-text-faint py-10 text-center text-sm">Cargando la conversación…</p>

		<div class="bg-bg/90 border-border-soft sticky bottom-0 -mx-4 border-t px-4 pt-4 pb-5 backdrop-blur-xl sm:-mx-8 sm:px-8">
			<p id="status" role="status" class="text-text-faint mb-2 min-h-5 text-sm"></p>
			<form id="composer" class="flex items-end gap-3">
				<textarea
					rows="2"
					maxlength="2000"
					placeholder="Escribe un mensaje…"
					aria-label="Mensaje"
					class="border-border bg-bg-soft text-text focus-visible:border-brand min-h-[56px] flex-1 resize-none rounded-lg border px-3.5 py-2.5 text-sm leading-relaxed outline-none transition-colors"
				></textarea>
				<button
					type="submit"
					class="bg-brand hover:bg-brand-hover h-[42px] rounded-lg px-5 text-sm font-bold text-white transition-colors disabled:opacity-60"
				>
					Enviar
				</button>
			</form>
		</div>
	</main>
</Layout>

<script>
	import "../../../scripts/support-chat";
</script>
