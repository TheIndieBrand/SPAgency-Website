---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../lib/site";

// What a donation funds, kept honest: no invented perks, no numbers we can't back.
const reasons = [
	{ icon: "bi-hdd-network", title: "Hosting y dominio", desc: "El bot y la web tienen que vivir en algún servidor." },
	{ icon: "bi-code-slash", title: "Tiempo de desarrollo", desc: "Nuevas funciones y mantenimiento, fuera de horas de trabajo." },
	{ icon: "bi-slash-circle", title: "Cero anuncios", desc: "Nada de publicidad ni límites de pago en el bot o el dashboard." },
	{ icon: "bi-shield-check", title: "Misma protección para todos", desc: "Donar no cambia nada de lo que recibe tu servidor." },
];

const otherWays = [
	{ icon: "bi-github", title: "Contribuye en GitHub", desc: "Código abierto: reporta fallos o manda un pull request.", href: site.githubUrl },
	{ icon: "bi-discord", title: "Habla con nosotros", desc: "Feedback, ideas o simplemente recomiéndanos en tu servidor.", href: site.discordUrl },
];
---

<Layout
	title="Donaciones — SP Agency"
	description="SP Agency es gratis. Si quieres ayudar a cubrir el hosting y el tiempo de desarrollo, puedes invitarnos a un café."
>
	<Navbar />

	<main class="mx-auto max-w-[880px] px-4 pt-16 pb-28 sm:px-8">
		<!-- ============ HERO + CTA ============ -->
		<div class="text-center">
			<div class="text-text-faint mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase">Donaciones</div>
			<h1 class="font-display text-[38px] leading-tight font-bold tracking-tight sm:text-[46px]">Apoya el proyecto</h1>
			<p class="text-text-dim mx-auto mt-3.5 max-w-[480px] text-base leading-relaxed">
				SP Agency es y seguirá siendo gratis. Si te gusta el proyecto, donar ayuda a mantenerlo, pero no cambia nada
				de lo que recibe tu servidor.
			</p>
		</div>

		<div class="border-border-soft bg-card relative mt-10 overflow-hidden rounded-[20px] border px-8 py-12 text-center sm:px-14">
			<!-- Faint brand glow behind the icon, same idea as the logo glow on /gracias. -->
			<div
				class="bg-brand pointer-events-none absolute top-0 left-1/2 h-[280px] w-[280px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-[0.12] blur-[90px]"
				aria-hidden="true"
			>
			</div>

			<div class="bg-brand-soft text-brand-hover relative mx-auto flex h-16 w-16 items-center justify-center rounded-2xl text-3xl">
				<i class="bi bi-cup-hot-fill" aria-hidden="true" />
			</div>
			<h2 class="font-display relative mt-6 text-2xl font-bold tracking-tight">Invítanos a un café</h2>
			<p class="text-text-dim relative mx-auto mt-2 max-w-[400px] text-sm leading-relaxed">
				Un aporte único o recurrente, lo que prefieras, a través de Buy Me a Coffee.
			</p>
			<a
				href={site.donateUrl}
				class="bg-brand hover:bg-brand-hover relative mt-7 inline-flex items-center gap-2.5 rounded-xl px-7 py-3.5 text-base font-bold text-white transition-colors"
			>
				<i class="bi bi-cup-hot-fill" aria-hidden="true" />
				Ir a Buy Me a Coffee
				<i class="bi bi-box-arrow-up-right text-sm" aria-hidden="true" />
			</a>
		</div>

		<!-- ============ EN QUÉ SE NOTA ============ -->
		<div class="border-border-soft bg-border-soft mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border sm:grid-cols-2">
			{
				reasons.map((r) => (
					<div class="bg-card px-7 py-6">
						<div class="border-border text-text mb-4 flex h-10 w-10 items-center justify-center rounded-[10px] border text-lg">
							<i class={`bi ${r.icon}`} />
						</div>
						<h3 class="text-[15px] font-bold">{r.title}</h3>
						<p class="text-text-dim mt-1.5 text-[13.5px] leading-relaxed">{r.desc}</p>
					</div>
				))
			}
		</div>

		<!-- ============ OTRAS FORMAS DE AYUDAR ============ -->
		<div class="mt-16">
			<h2 class="text-text-faint mb-4 text-[13px] font-bold tracking-[0.08em] uppercase">¿Prefieres ayudar de otra forma?</h2>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				{
					otherWays.map((w) => (
						<a
							href={w.href}
							class="border-border-soft hover:border-brand/50 bg-bg-soft group flex items-center gap-3.5 rounded-xl border px-4 py-3.5 transition-colors"
						>
							<span class="bg-brand-soft text-brand-hover flex h-9 w-9 shrink-0 items-center justify-center rounded-full">
								<i class={`bi ${w.icon}`} />
							</span>
							<span class="min-w-0 flex-1">
								<span class="text-text group-hover:text-brand-hover block text-sm font-bold transition-colors">{w.title}</span>
								<span class="text-text-faint block text-[13px]">{w.desc}</span>
							</span>
							<i class="bi bi-arrow-right text-text-dim group-hover:text-brand-hover transition-colors" />
						</a>
					))
				}
			</div>
		</div>
	</main>

	<Footer />
</Layout>
