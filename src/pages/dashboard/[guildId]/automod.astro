---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import DashboardShell from "../../../components/dashboard/DashboardShell.astro";
import SettingCard from "../../../components/dashboard/SettingCard.astro";
import Toggle from "../../../components/dashboard/Toggle.astro";
import FieldRow from "../../../components/dashboard/FieldRow.astro";
import { requireGuildAccess } from "../../../lib/dashboard-guard";
import { loadOrCreateGuildConfig } from "../../../lib/db/guild-config";
import { inputClass, selectClass } from "../../../lib/dashboard-ui";

const result = await requireGuildAccess(Astro, Astro.params.guildId);
if ("redirect" in result) return result.redirect;
const { guild } = result;

const loaded = await loadOrCreateGuildConfig(guild.id);
if (!loaded.ok) return Astro.rewrite(`/dashboard/unavailable?reason=${loaded.reason}`);
const { moderation, protection } = loaded.config;
---

<Layout title={`Automoderación — ${guild.name}`}>
	<DashboardShell
		guild={guild}
		active="automod"
		title="Automoderación"
		subtitle="Filtros de conducta en mensajes: spam, mayúsculas, emojis, texto largo, y qué pasa cuando alguien acumula infracciones."
		raidmodeActive={protection.raidmodeEnable}
	>
		<div class="flex flex-col gap-6">
			<SettingCard title="Flood" description="Límites fijos de frecuencia (no configurables): 5 mensajes/5s por usuario, 4 webhooks/10s por canal.">
				<div class="divide-border-soft divide-y">
					<Toggle name="antiflood" label="Anti-flood de mensajes" checked={moderation.antiflood} />
					<Toggle name="antiWebhooksFlood" label="Anti-flood de webhooks" checked={moderation.antiWebhooksFlood} />
					<Toggle name="ghostpingEnable" label="Detectar ghost-pings" description="Menciones borradas casi al instante tras enviarse." checked={moderation.ghostpingEnable} />
				</div>
			</SettingCard>

			<SettingCard title="Mayúsculas (Caps Lock)" description="Marca mensajes con un porcentaje alto de mayúsculas." name="capsLockEnable" checked={moderation.capsLockEnable}>
				<div class="divide-border-soft divide-y">
					<FieldRow label="Umbral" description="Porcentaje mínimo de mayúsculas para considerarlo infracción.">
						<div class="flex items-center gap-2">
							<input type="number" name="capsLockThreshold" data-depends="capsLockEnable" min="1" max="100" value={moderation.capsLockThreshold} class={inputClass + " !w-20 !min-w-0 sm:!w-20"} disabled={!moderation.capsLockEnable} />
							<span class="text-text-faint text-sm">%</span>
						</div>
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Exceso de emojis" description="Marca mensajes con demasiados emojis." name="manyEmojisEnable" checked={moderation.manyEmojisEnable}>
				<div class="divide-border-soft divide-y">
					<FieldRow label="Umbral" description="Cantidad de emojis en un mismo mensaje.">
						<input type="number" name="manyEmojisThreshold" data-depends="manyEmojisEnable" min="1" value={moderation.manyEmojisThreshold} class={inputClass + " !w-20 !min-w-0 sm:!w-20"} disabled={!moderation.manyEmojisEnable} />
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Mensajes largos" description="Marca mensajes con demasiadas palabras." name="manyWordsEnable" checked={moderation.manyWordsEnable}>
				<div class="divide-border-soft divide-y">
					<FieldRow label="Umbral" description="Cantidad de palabras en un mismo mensaje.">
						<input type="number" name="manyWordsThreshold" data-depends="manyWordsEnable" min="1" value={moderation.manyWordsThreshold} class={inputClass + " !w-20 !min-w-0 sm:!w-20"} disabled={!moderation.manyWordsEnable} />
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Escalado de sanciones" description="Qué pasa cuando un mismo usuario acumula infracciones de cualquiera de los filtros anteriores (o del AutoMod nativo de Discord).">
				<div class="divide-border-soft divide-y">
					<FieldRow label="Silenciar (timeout) a partir de" description="Número de infracciones acumuladas.">
						<div class="flex items-center gap-2">
							<input type="number" name="automodMuteAt" min="1" value={moderation.automodMuteAt} class={inputClass + " !w-20 !min-w-0 sm:!w-20"} />
							<span class="text-text-faint text-sm">infracciones</span>
						</div>
					</FieldRow>
					<FieldRow label="Duración del silencio">
						<div class="flex items-center gap-2">
							<input type="number" name="automodMuteMinutes" min="1" value={moderation.automodMuteMinutes} class={inputClass + " !w-20 !min-w-0 sm:!w-20"} />
							<span class="text-text-faint text-sm">minutos</span>
						</div>
					</FieldRow>
					<FieldRow label="Acción final" description="Qué hacer si el usuario sigue infringiendo tras el silencio.">
						<select name="automodFinalAction" class={selectClass}>
							<option value="none" selected={moderation.automodFinalAction === "none"}>No hacer nada</option>
							<option value="kick" selected={moderation.automodFinalAction === "kick"}>Expulsar</option>
							<option value="ban" selected={moderation.automodFinalAction === "ban"}>Banear</option>
						</select>
					</FieldRow>
					<FieldRow label="Acción final a partir de" description="Número de infracciones acumuladas para aplicar la acción final.">
						<div class="flex items-center gap-2">
							<input type="number" name="automodFinalActionAt" min="1" value={moderation.automodFinalActionAt} class={inputClass + " !w-20 !min-w-0 sm:!w-20"} />
							<span class="text-text-faint text-sm">infracciones</span>
						</div>
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Razones predefinidas" description="Lista de razones rápidas que el staff puede usar al moderar.">
				<div class="mb-4 flex flex-wrap gap-2" data-list="forceReasons" data-empty="Sin razones predefinidas: los comandos de moderación aceptan cualquier razón.">
					{
						moderation.forceReasons.length === 0 ? (
							<p class="text-text-faint text-xs">Sin razones predefinidas: los comandos de moderación aceptan cualquier razón.</p>
						) : (
							moderation.forceReasons.map((reason) => (
								<span data-item={reason} class="border-border bg-bg-soft text-text-dim inline-flex items-center gap-2 rounded-full border py-1.5 pr-2 pl-3 text-xs font-semibold">
									{reason}
									<button type="button" data-remove class="text-text-faint transition-colors hover:text-[#ef4444]" aria-label={`Eliminar razón "${reason}"`}>
										<i class="bi bi-x-lg text-[10px]" />
									</button>
								</span>
							))
						)
					}
				</div>
				<div class="flex items-center gap-2">
					<input type="text" data-list-input="forceReasons" maxlength="100" placeholder="Nueva razón…" class={inputClass} />
					<button type="button" data-list-add="forceReasons" class="bg-brand hover:bg-brand-hover shrink-0 rounded-lg px-4 py-2 text-sm font-bold text-white transition-colors">
						Añadir
					</button>
				</div>
			</SettingCard>
		</div>
	</DashboardShell>
</Layout>
