---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import DashboardShell from "../../../components/dashboard/DashboardShell.astro";
import SettingCard from "../../../components/dashboard/SettingCard.astro";
import Toggle from "../../../components/dashboard/Toggle.astro";
import FieldRow from "../../../components/dashboard/FieldRow.astro";
import { requireGuildAccess } from "../../../lib/dashboard-guard";
import { getMockGuildConfig } from "../../../lib/mock-config";
import { inputClass, selectClass } from "../../../lib/dashboard-ui";

const result = await requireGuildAccess(Astro, Astro.params.guildId);
if ("redirect" in result) return result.redirect;
const { guild } = result;

const { moderation, protection } = getMockGuildConfig();
---

<Layout title={`Automoderación — ${guild.name}`}>
	<DashboardShell
		guild={guild}
		active="automod"
		title="Automoderación"
		subtitle="Filtros de conducta en mensajes: spam, mayúsculas, emojis, texto largo, y qué pasa cuando alguien acumula infracciones."
		raidmodeActive={protection.raidmodeEnable}
	>
		<div class="flex flex-col gap-6">
			<SettingCard title="Flood" description="Límites fijos de frecuencia (no configurables): 5 mensajes/5s por usuario, 4 webhooks/10s por canal." icon="bi-lightning-charge">
				<div class="divide-border-soft divide-y">
					<Toggle name="antiflood" label="Anti-flood de mensajes" checked={moderation.antiflood} />
					<Toggle name="antiWebhooksFlood" label="Anti-flood de webhooks" checked={moderation.antiWebhooksFlood} />
					<Toggle name="ghostpingEnable" label="Detectar ghost-pings" description="Menciones borradas casi al instante tras enviarse." checked={moderation.ghostpingEnable} />
				</div>
			</SettingCard>

			<SettingCard title="Mayúsculas (Caps Lock)" description="Marca mensajes con un porcentaje alto de mayúsculas." icon="bi-type-bold">
				<div class="divide-border-soft divide-y">
					<Toggle name="capsLockEnable" label="Activar filtro" checked={moderation.capsLockEnable} />
					<FieldRow label="Umbral" description="Porcentaje mínimo de mayúsculas para considerarlo infracción.">
						<div class="flex items-center gap-2">
							<input type="number" min="1" max="100" value={moderation.capsLockThreshold} class={inputClass + " !w-20 sm:!w-20"} disabled={!moderation.capsLockEnable} />
							<span class="text-text-faint text-sm">%</span>
						</div>
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Exceso de emojis" description="Marca mensajes con demasiados emojis." icon="bi-emoji-smile">
				<div class="divide-border-soft divide-y">
					<Toggle name="manyEmojisEnable" label="Activar filtro" checked={moderation.manyEmojisEnable} />
					<FieldRow label="Umbral" description="Cantidad de emojis en un mismo mensaje.">
						<input type="number" min="1" value={moderation.manyEmojisThreshold} class={inputClass + " !w-20 sm:!w-20"} disabled={!moderation.manyEmojisEnable} />
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Mensajes largos" description="Marca mensajes con demasiadas palabras." icon="bi-file-text">
				<div class="divide-border-soft divide-y">
					<Toggle name="manyWordsEnable" label="Activar filtro" checked={moderation.manyWordsEnable} />
					<FieldRow label="Umbral" description="Cantidad de palabras en un mismo mensaje.">
						<input type="number" min="1" value={moderation.manyWordsThreshold} class={inputClass + " !w-20 sm:!w-20"} disabled={!moderation.manyWordsEnable} />
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Escalado de sanciones" description="Qué pasa cuando un mismo usuario acumula infracciones de cualquiera de los filtros anteriores (o del AutoMod nativo de Discord)." icon="bi-bar-chart-steps">
				<div class="divide-border-soft divide-y">
					<FieldRow label="Silenciar (timeout) a partir de" description="Número de infracciones acumuladas.">
						<div class="flex items-center gap-2">
							<input type="number" min="1" value={moderation.automodMuteAt} class={inputClass + " !w-20 sm:!w-20"} />
							<span class="text-text-faint text-sm">infracciones</span>
						</div>
					</FieldRow>
					<FieldRow label="Duración del silencio">
						<div class="flex items-center gap-2">
							<input type="number" min="1" value={moderation.automodMuteMinutes} class={inputClass + " !w-20 sm:!w-20"} />
							<span class="text-text-faint text-sm">minutos</span>
						</div>
					</FieldRow>
					<FieldRow label="Acción final" description="Qué hacer si el usuario sigue infringiendo tras el silencio.">
						<select class={selectClass}>
							<option value="none" selected={moderation.automodFinalAction === "none"}>No hacer nada</option>
							<option value="kick" selected={moderation.automodFinalAction === "kick"}>Expulsar</option>
							<option value="ban" selected={moderation.automodFinalAction === "ban"}>Banear</option>
						</select>
					</FieldRow>
					<FieldRow label="Acción final a partir de" description="Número de infracciones acumuladas para aplicar la acción final.">
						<div class="flex items-center gap-2">
							<input type="number" min="1" value={moderation.automodFinalActionAt} class={inputClass + " !w-20 sm:!w-20"} />
							<span class="text-text-faint text-sm">infracciones</span>
						</div>
					</FieldRow>
				</div>
			</SettingCard>

			<SettingCard title="Razones predefinidas" description="Lista de razones rápidas que el staff puede usar al moderar." icon="bi-list-check">
				<div class="flex flex-wrap gap-2">
					{
						moderation.forceReasons.map((reason) => (
							<span class="border-border bg-bg-soft text-text-dim inline-flex items-center gap-2 rounded-full border py-1.5 pr-2 pl-3 text-xs font-semibold">
								{reason}
								<button type="button" class="text-text-faint hover:text-[#ef4444] transition-colors" aria-label={`Eliminar razón "${reason}"`}>
									<i class="bi bi-x-lg text-[10px]" />
								</button>
							</span>
						))
					}
					<button type="button" class="border-border-soft text-text-faint hover:border-brand hover:text-brand rounded-full border border-dashed px-3 py-1.5 text-xs font-bold transition-colors">
						<i class="bi bi-plus mr-1" />
						Añadir razón
					</button>
				</div>
			</SettingCard>
		</div>
	</DashboardShell>
</Layout>
