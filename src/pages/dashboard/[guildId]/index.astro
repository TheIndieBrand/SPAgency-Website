---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import DashboardShell from "../../../components/dashboard/DashboardShell.astro";
import { requireGuildAccess } from "../../../lib/dashboard-guard";
import { describeActivity, listActivity } from "../../../lib/db/activity";
import { loadOrCreateGuildConfig } from "../../../lib/db/guild-config";
import { EMPTY_OVERVIEW, deltaText, getOverview } from "../../../lib/db/overview";

const result = await requireGuildAccess(Astro, Astro.params.guildId);
if ("redirect" in result) return result.redirect;
const { guild } = result;

const loaded = await loadOrCreateGuildConfig(guild.id);
if (!loaded.ok) return Astro.rewrite(`/dashboard/unavailable?reason=${loaded.reason}`);
const config = loaded.config;

const [overview, rows] = await Promise.all([getOverview(guild.id), listActivity(guild.id, 5)]);
const stats = overview ?? EMPTY_OVERVIEW;
const activity = (rows ?? []).map(describeActivity);
const show = (n: number) => (overview ? String(n) : "—");

const kpis = [
	{ label: "Ataques bloqueados hoy", value: show(stats.raidsToday), delta: overview ? deltaText(stats.raidsToday, stats.raidsYesterday, "vs ayer") : "", icon: "bi-shield-fill-check" },
	{ label: "Cuentas maliciosas detectadas (7d)", value: show(stats.maliciousWeek), delta: overview ? deltaText(stats.maliciousWeek, stats.maliciousPrevWeek, "vs semana pasada") : "", icon: "bi-person-fill-x" },
	{ label: "Advertencias emitidas (7d)", value: show(stats.warnsWeek), delta: overview ? deltaText(stats.warnsWeek, stats.warnsPrevWeek, "vs semana pasada") : "", icon: "bi-exclamation-triangle" },
	{ label: "Respuestas automáticas (7d)", value: show(stats.autoActionsWeek), delta: overview ? deltaText(stats.autoActionsWeek, stats.autoActionsPrevWeek, "vs semana pasada") : "", icon: "bi-activity" },
];

const modules = [
	{ label: "Anti-Raid", enabled: config.protection.antiraidEnable, href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Anti-Bots", enabled: config.protection.antibotsEnable, href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Detección de selfbots", enabled: config.protection.selfbotAction !== "none", href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Verificación", enabled: config.protection.verificationEnable, href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Automoderación (antiflood)", enabled: config.moderation.antiflood, href: `/dashboard/${guild.id}/automod` },
	{ label: "Canal de logs", enabled: Boolean(config.configuration.logsChannel), href: `/dashboard/${guild.id}/alerts` },
];

const toneClass: Record<string, string> = {
	danger: "text-[#ef4444]",
	warning: "text-[#f59e0b]",
	info: "text-brand",
	success: "text-emerald",
};
---

<Layout title={`${guild.name} — SP Agency`}>
	<DashboardShell guild={guild} active="general" title="General" subtitle="Estado general de la protección de tu servidor." raidmodeActive={config.protection.raidmodeEnable}>
		<!-- KPI cards -->
		<div class="mb-6 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
			{
				kpis.map((kpi) => (
					<div class="border-border-soft bg-card rounded-[14px] border p-5">
						<div class="text-text-faint mb-3 flex items-center gap-2 text-xs font-semibold">
							<i class={`bi ${kpi.icon} text-brand`} />
							{kpi.label}
						</div>
						<div class="flex items-end justify-between">
							<span class="font-display text-3xl font-bold tracking-tight">{kpi.value}</span>
							<span class="text-text-faint text-xs">{kpi.delta}</span>
						</div>
					</div>
				))
			}
		</div>

		<div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
			<!-- Module status -->
			<div class="border-border-soft bg-card rounded-[14px] border p-5 lg:col-span-2">
				<h2 class="text-text mb-4 text-sm font-bold">Estado de los módulos</h2>
				<div class="divide-border-soft divide-y">
					{
						modules.map((m) => (
							<a href={m.href} class="hover:bg-bg-soft -mx-2 flex items-center justify-between gap-3 rounded-lg px-2 py-3 transition-colors">
								<span class="text-text-dim text-sm font-medium">{m.label}</span>
								<span
									class:list={[
										"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold whitespace-nowrap",
										m.enabled ? "border-emerald/30 bg-emerald/10 text-emerald" : "border-border text-text-faint",
									]}
								>
									<span class:list={["inline-block h-1.5 w-1.5 rounded-full", m.enabled ? "bg-emerald" : "bg-text-faint"]} />
									{m.enabled ? "Activo" : "Inactivo"}
								</span>
							</a>
						))
					}
				</div>
			</div>

			<!-- Live activity console -->
			<div class="border-border-soft bg-bg-soft rounded-[14px] border lg:col-span-3">
				<div class="border-border-soft flex items-center gap-2.5 border-b px-4 py-3.5">
					<i class="bi bi-terminal text-text-dim text-sm" />
					<span class="text-text text-sm font-semibold">Actividad reciente</span>
				</div>
				<div class="divide-border-soft divide-y">
					{
						activity.length === 0 && (
							<p class="text-text-faint px-4 py-8 text-center text-[13px]">Aún no hay actividad registrada en este servidor.</p>
						)
					}
					{
						activity.map((event) => (
							<div class="flex items-start gap-3 px-4 py-2.5 text-[13px]">
								<time datetime={event.at} data-local class="text-text-faint shrink-0 tabular-nums">{event.at.slice(11, 16)}</time>
								<i class={`bi ${event.icon} ${toneClass[event.tone]} mt-0.5 shrink-0 text-xs`} />
								<span class="text-text-dim leading-relaxed">{event.label}</span>
							</div>
						))
					}
				</div>
				<a href={`/dashboard/${guild.id}/logs`} class="text-brand hover:text-brand-hover block border-t border-border-soft px-4 py-3 text-center text-xs font-bold transition-colors">
					Ver todos los registros
				</a>
			</div>
		</div>
	</DashboardShell>
</Layout>

<script>
	import { localizeTimes } from "../../../scripts/support-ui";
	localizeTimes();
</script>
