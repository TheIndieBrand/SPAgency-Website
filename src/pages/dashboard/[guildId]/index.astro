---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import DashboardShell from "../../../components/dashboard/DashboardShell.astro";
import { requireGuildAccess } from "../../../lib/dashboard-guard";
import { activityRepository, describeActivity } from "../../../lib/db/ActivityRepository";
import { guildConfigRepository } from "../../../lib/db/GuildConfigRepository";
import { EMPTY_OVERVIEW, deltaText, overviewRepository } from "../../../lib/db/OverviewRepository";

const result = await requireGuildAccess(Astro, Astro.params.guildId);
if ("redirect" in result) return result.redirect;
const { guild } = result;

const loaded = await guildConfigRepository.loadOrCreateGuildConfig(guild.id);
if (!loaded.ok) return Astro.rewrite(`/dashboard/unavailable?reason=${loaded.reason}`);
const config = loaded.config;

const [overview, rows] = await Promise.all([overviewRepository.getOverview(guild.id), activityRepository.listActivity(guild.id, 5)]);
const stats = overview ?? EMPTY_OVERVIEW;
const activity = (rows ?? []).map(describeActivity);
const show = (n: number) => (overview ? String(n) : "—");

const kpis = [
	{ label: "Ataques bloqueados hoy", value: show(stats.raidsToday), delta: overview ? deltaText(stats.raidsToday, stats.raidsYesterday, "vs ayer") : "" },
	{ label: "Cuentas maliciosas detectadas (7d)", value: show(stats.maliciousWeek), delta: overview ? deltaText(stats.maliciousWeek, stats.maliciousPrevWeek, "vs semana pasada") : "" },
	{ label: "Advertencias emitidas (7d)", value: show(stats.warnsWeek), delta: overview ? deltaText(stats.warnsWeek, stats.warnsPrevWeek, "vs semana pasada") : "" },
	{ label: "Respuestas automáticas (7d)", value: show(stats.autoActionsWeek), delta: overview ? deltaText(stats.autoActionsWeek, stats.autoActionsPrevWeek, "vs semana pasada") : "" },
];

const modules = [
	{ label: "Anti-Raid", enabled: config.protection.antiraidEnable, href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Anti-Bots", enabled: config.protection.antibotsEnable, href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Detección de selfbots", enabled: config.protection.selfbotAction !== "none", href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Verificación", enabled: config.protection.verificationEnable, href: `/dashboard/${guild.id}/antiraid` },
	{ label: "Automoderación (antiflood)", enabled: config.moderation.antiflood, href: `/dashboard/${guild.id}/automod` },
	{ label: "Canal de logs", enabled: Boolean(config.configuration.logsChannel), href: `/dashboard/${guild.id}/alerts` },
];

const toneClass: Record<string, string> = {
	danger: "text-[#ef4444]",
	warning: "text-[#f59e0b]",
	info: "text-brand",
	success: "text-emerald",
};
---

<Layout title={`${guild.name} — SP Agency`}>
	<DashboardShell guild={guild} active="general" title="General" subtitle="Estado general de la protección de tu servidor." raidmodeActive={config.protection.raidmodeEnable}>
		<!-- Cifras: una sola pieza con separadores finos, sin iconos -->
		<div class="border-border-soft bg-border-soft mb-6 grid grid-cols-2 gap-px overflow-hidden rounded-[14px] border xl:grid-cols-4">
			{
				kpis.map((kpi) => (
					<div class="bg-card p-5">
						<p class="text-text-faint text-xs">{kpi.label}</p>
						<p class="font-display mt-2 text-3xl font-bold tracking-tight">{kpi.value}</p>
						<p class="text-text-faint mt-1 min-h-4 text-xs">{kpi.delta}</p>
					</div>
				))
			}
		</div>

		<div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
			<!-- Module status -->
			<div class="border-border-soft bg-card rounded-[14px] border p-5 lg:col-span-2">
				<h2 class="text-text mb-2 text-sm font-bold">Módulos</h2>
				<div>
					{
						modules.map((m) => (
							<a href={m.href} class="group hover:bg-bg-soft -mx-2 flex items-center gap-3 rounded-lg px-2 py-2.5 transition-colors">
								<span class:list={["inline-block h-1.5 w-1.5 shrink-0 rounded-full", m.enabled ? "bg-emerald" : "bg-text-faint/40"]} />
								<span class:list={["min-w-0 flex-1 text-sm", m.enabled ? "text-text" : "text-text-dim"]}>{m.label}</span>
								<span class="text-text-faint text-xs">{m.enabled ? "Activo" : "Desactivado"}</span>
								<i class="bi bi-chevron-right text-text-faint group-hover:text-brand -ml-1 text-[11px] transition-colors" />
							</a>
						))
					}
				</div>
			</div>

			<!-- Recent activity -->
			<div class="border-border-soft bg-card rounded-[14px] border lg:col-span-3">
				<div class="border-border-soft flex items-center justify-between gap-3 border-b px-5 py-3.5">
					<h2 class="text-text text-sm font-bold">Actividad reciente</h2>
					<a href={`/dashboard/${guild.id}/logs`} class="text-text-faint hover:text-brand text-xs font-semibold transition-colors">Ver todo</a>
				</div>
				<div class="divide-border-soft divide-y">
					{
						activity.length === 0 && (
							<p class="text-text-faint px-5 py-8 text-center text-[13px]">Aún no hay actividad registrada en este servidor.</p>
						)
					}
					{
						activity.map((event) => (
							<div class="flex items-start gap-3 px-5 py-2.5 text-[13px]">
								<time datetime={event.at} data-local class="text-text-faint shrink-0 tabular-nums">{event.at.slice(11, 16)}</time>
								<i class={`bi ${event.icon} ${toneClass[event.tone]} mt-0.5 shrink-0 text-xs`} />
								<span class="text-text-dim leading-relaxed">{event.label}</span>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</DashboardShell>
</Layout>

<script>
	import { localizeTimes } from "../../../scripts/support-ui";
	localizeTimes();
</script>
