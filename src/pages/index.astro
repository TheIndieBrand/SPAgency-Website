---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import AsymptoteScene from "../components/AsymptoteScene.astro";
import SceneCta from "../components/SceneCta.astro";
import Features from "../components/Features.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Testimonials from "../components/Testimonials.astro";
import CtaSection from "../components/CtaSection.astro";
import FeaturesA11y from "../components/FeaturesA11y.astro";
import StepsA11y from "../components/StepsA11y.astro";
import TestimonialsA11y from "../components/TestimonialsA11y.astro";
import Footer from "../components/Footer.astro";
---

<Layout customScrollbar={false}>
	<!-- Decide, antes del primer pintado, si se ve la escena animada o la versión
	     simple. La escena solo con ancho >= 1024px y sin prefers-reduced-motion;
	     en cualquier otro caso (móvil, tablet, reduced-motion, sin JS) queda la
	     versión simple. El CSS de global.css alterna .scene-only / .static-only
	     según este atributo. -->
	<script is:inline slot="head">
		if (matchMedia("(min-width: 1024px) and (prefers-reduced-motion: no-preference)").matches) {
			document.documentElement.dataset.scene = "on";
		}
	</script>

	<div class="relative">
		<Navbar />

		<!-- Hero + stats son comunes a las dos versiones; el resto de la escena
		     (asíntota, agujero negro, pasos, CTA) es scene-only. -->
		<div id="intro-scene" class="relative z-0 min-h-screen overflow-clip">
			<Hero />
			<Stats />
			<AsymptoteScene />
			<SceneCta />
		</div>

		<!-- Versión simple (static-only: se oculta con la escena). Tiene el mismo
		     contenido que la escena; los datos viven en src/lib. -->
		<Features />
		<HowItWorks />
		<Testimonials />
		<CtaSection />

		<!-- Con la escena, el contenido de arriba se ve animado dentro de ella, que
		     es aria-hidden: estas son sus versiones para lectores de pantalla
		     (scene-only, sr-only). -->
		<FeaturesA11y />
		<StepsA11y />
		<TestimonialsA11y />

		<Footer />
	</div>
</Layout>

<style is:global>
	/* Sin barra de scroll en el home (se sigue pudiendo hacer scroll con rueda,
	   teclado y táctil). El resto de páginas la conservan. */
	html {
		scrollbar-width: none;
	}
	html::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	// the version (scene or simple) is decided on load. if the threshold is
	// crossed afterward (rotating a tablet, resizing the window, toggling the
	// system's reduced-motion setting), the page reloads to show the right
	// one: the scene can't be mounted or unmounted live (pinning, measurements...).
	const sceneQuery = matchMedia("(min-width: 1024px) and (prefers-reduced-motion: no-preference)");
	const sceneWanted = sceneQuery.matches;
	sceneQuery.addEventListener("change", () => {
		if (sceneQuery.matches !== sceneWanted) location.reload();
	});

	// the scene (gsap + ScrollTrigger + script) only downloads and mounts when
	// the <head> script enabled it. if it fails to load, it falls back to the simple version.
	if (document.documentElement.dataset.scene === "on") {
		// the scene measures the layout on mount (title position, number
		// widths...) and those measurements depend on the real fonts: it waits
		// for them to load so it doesn't measure with the fallback font on a
		// first visit with no cache. capped at 3s in case the network is slow.
		// the scene's script downloads in parallel, not afterward.
		const fontFaces = [
			"400 16px Manrope",
			"500 16px Manrope",
			"600 16px Manrope",
			"700 16px Manrope",
			'500 16px "Space Grotesk"',
			'600 16px "Space Grotesk"',
			'700 16px "Space Grotesk"',
		];
		const fontsReady = Promise.race([
			Promise.all(fontFaces.map((face) => document.fonts.load(face))).catch(() => {}),
			new Promise((resolve) => setTimeout(resolve, 3000)),
		]);
		Promise.all([import("../scripts/intro-scene"), fontsReady])
			.then(([scene]) => scene.mountScene())
			.catch(() => {
				delete document.documentElement.dataset.scene;
			});
	}
</script>
