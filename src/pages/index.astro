---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import AsymptoteScene from "../components/AsymptoteScene.astro";
import SceneCta from "../components/SceneCta.astro";
import Features from "../components/Features.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Testimonials from "../components/Testimonials.astro";
import CtaSection from "../components/CtaSection.astro";
import FeaturesA11y from "../components/FeaturesA11y.astro";
import StepsA11y from "../components/StepsA11y.astro";
import TestimonialsA11y from "../components/TestimonialsA11y.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
	<!-- Decide, antes del primer pintado, si se ve la escena animada o la versión
	     simple. La escena solo con ancho >= 1024px y sin prefers-reduced-motion;
	     en cualquier otro caso (móvil, tablet, reduced-motion, sin JS) queda la
	     versión simple. El CSS de global.css alterna .scene-only / .static-only
	     según este atributo. -->
	<script is:inline slot="head">
		if (matchMedia("(min-width: 1024px) and (prefers-reduced-motion: no-preference)").matches) {
			document.documentElement.dataset.scene = "on";
		}
	</script>

	<div class="relative">
		<Navbar />

		<!-- Hero + stats son comunes a las dos versiones; el resto de la escena
		     (asíntota, agujero negro, pasos, CTA) es scene-only. -->
		<div id="intro-scene" class="relative z-0 min-h-screen overflow-clip">
			<Hero />
			<Stats />
			<AsymptoteScene />
			<SceneCta />
		</div>

		<!-- Versión simple (static-only: se oculta con la escena). Tiene el mismo
		     contenido que la escena; los datos viven en src/lib. -->
		<Features />
		<HowItWorks />
		<Testimonials />
		<CtaSection />

		<!-- Con la escena, el contenido de arriba se ve animado dentro de ella, que
		     es aria-hidden: estas son sus versiones para lectores de pantalla
		     (scene-only, sr-only). -->
		<FeaturesA11y />
		<StepsA11y />
		<TestimonialsA11y />

		<Footer />
	</div>
</Layout>

<script>
	// La escena (gsap + ScrollTrigger + script) solo se descarga y monta cuando
	// el script de <head> la habilitó. Si no carga, se vuelve a la versión simple.
	if (document.documentElement.dataset.scene === "on") {
		import("../scripts/intro-scene").catch(() => {
			delete document.documentElement.dataset.scene;
		});
	}
</script>
