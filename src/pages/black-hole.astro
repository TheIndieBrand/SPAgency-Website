---
// isolated TEST page for the <BlackHole /> component. not linked from
// anywhere on the site and not part of the normal flow — it's just to see
// the black hole's design without scrolling through the whole intro-scene.ts
// scene. delete it (or the component) if it ends up unused.
//
// only exists in development: in production it responds 404.
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

import Layout from "../layouts/Layout.astro";
import BlackHole from "../components/BlackHole.astro";
---

<Layout title="Black hole — test">
	<main class="flex min-h-screen flex-col items-center justify-center gap-10 bg-black py-24">
		<BlackHole size={520} controls />

		<p class="text-text-dim max-w-md px-6 text-center text-sm">
			Vista de prueba de <code class="text-text">&lt;BlackHole /&gt;</code> — componente aislado, sin conectar
			a la escena principal. El grande tiene <code class="text-text">controls</code>: arrástralo con el ratón
			para orbitar la cámara; al soltar imprime <code class="text-text">yaw / pitch / dist</code> en la
			consola. Esos valores se fijan luego en <code class="text-text">DEFAULT_*</code>.
		</p>

		<div class="flex flex-wrap items-center justify-center gap-16">
			<BlackHole size={200} />
			<BlackHole size={320} />
		</div>
	</main>
</Layout>
