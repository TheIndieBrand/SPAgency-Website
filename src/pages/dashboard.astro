---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

// Aquí no se espera a Discord: la lista de servidores es lo lento, así que la
// página se pinta al momento con tarjetas de carga y la lista llega después
// desde /api/dashboard/guilds. Solo se comprueba que haya sesión.
const cookieName = process.env.SESSION_COOKIE_NAME || "spa_session";
if (!Astro.cookies.get(cookieName)?.value) return Astro.redirect("/auth/discord/login");

const botTokenMissing = !process.env.DISCORD_BOT_TOKEN;
const skeletons = Array.from({ length: 8 });
---

<Layout title="Dashboard — SP Agency">
	<div class="bg-bg min-h-screen">
		<Navbar />

		<section class="mx-auto max-w-[1280px] px-8 pt-10 pb-24">
			{
				botTokenMissing && (
					<div class="border-border bg-bg-soft mb-8 rounded-[14px] border px-6 py-4 text-sm text-text-dim">
						Falta configurar <code class="text-brand">DISCORD_BOT_TOKEN</code> — no se puede comprobar en qué
						servidores está el bot todavía.
					</div>
				)
			}

			<!-- ============ TOOLBAR ============ -->
			<div class="mb-8 flex flex-col gap-5">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<div class="flex items-center gap-3">
						<h1 class="font-display text-2xl font-bold tracking-tight">Tus servidores</h1>
						<span id="count-skeleton" class="skeleton h-[22px] w-8 rounded-full" aria-hidden="true"></span>
						<span id="count" hidden class="border-border text-text-dim rounded-full border px-2.5 py-0.5 text-xs font-bold"></span>
					</div>

					<div class="relative w-full sm:w-64">
						<i class="bi bi-search text-text-faint pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-sm" />
						<input
							id="server-search"
							type="text"
							placeholder="Buscar servidor..."
							class="border-border bg-bg-soft text-text placeholder:text-text-faint focus-visible:border-brand w-full rounded-lg border py-2 pr-3 pl-9 text-sm outline-none transition-colors"
						/>
					</div>
				</div>

				<div class="flex items-center gap-2" id="status-filters">
					<button
						type="button"
						data-filter="all"
						class="filter-btn bg-text text-[#191919] rounded-full px-4 py-1.5 text-xs font-bold transition-colors"
					>
						Todos
					</button>
					<button
						type="button"
						data-filter="protected"
						class="filter-btn border-border text-text-dim hover:border-brand hover:text-brand border rounded-full px-4 py-1.5 text-xs font-bold transition-colors"
					>
						Protegidos <span data-count="protected"></span>
					</button>
					<button
						type="button"
						data-filter="pending"
						class="filter-btn border-border text-text-dim hover:border-brand hover:text-brand border rounded-full px-4 py-1.5 text-xs font-bold transition-colors"
					>
						Por configurar <span data-count="pending"></span>
					</button>
				</div>
			</div>

			<!-- ============ GRID ============ -->
			<!-- Tarjetas de carga con la misma forma que las reales; el script las
			     sustituye por los servidores cuando llegan. -->
			<div
				id="server-grid"
				aria-busy="true"
				class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
			>
				<span class="sr-only" role="status">Cargando tus servidores…</span>
				{
					skeletons.map((_, i) => (
						<div
							class="border-border-soft bg-card flex h-full flex-col justify-between rounded-[14px] border p-5"
							aria-hidden="true"
							data-skeleton
							style={`--i:${i}`}
						>
							<div>
								<div class="mb-4 flex items-start justify-between gap-2">
									<div class="flex min-w-0 flex-1 items-center gap-3">
										<div class="skeleton h-11 w-11 shrink-0 rounded-full" />
										<div class="min-w-0 flex-1 space-y-2">
											<div class="skeleton h-3.5 w-3/4 rounded" />
											<div class="skeleton h-3 w-1/2 rounded" />
										</div>
									</div>
									<div class="skeleton h-6 w-20 shrink-0 rounded-full" />
								</div>
								<div class="border-border-soft flex items-center gap-4 border-t pt-4">
									<div class="skeleton h-3 w-28 rounded" />
									<div class="skeleton h-3 w-20 rounded" />
								</div>
							</div>
							<div class="skeleton mt-4 h-[42px] w-full rounded-[10px]" />
						</div>
					))
				}
			</div>

			<!-- ============ ERROR ============ -->
			<div id="load-error" hidden class="border-border-soft bg-card rounded-[14px] border px-8 py-16 text-center">
				<p class="text-text-dim mb-6 text-base">No se pudo cargar tu lista de servidores. Discord no responde ahora mismo.</p>
				<button
					id="retry"
					type="button"
					class="border-border hover:border-brand hover:text-brand rounded-[10px] border px-5 py-2.5 text-sm font-bold transition-colors"
				>
					Reintentar
				</button>
			</div>

			<!-- ============ EMPTY STATE ============ -->
			<div id="no-guilds" hidden class="border-border-soft bg-card rounded-[14px] border px-8 py-16 text-center">
				<p class="text-text-dim text-base">No encontramos servidores de Discord donde seas administrador.</p>
			</div>

			<!-- ============ EMPTY STATE (search) ============ -->
			<div id="empty-state" class="hidden py-20 text-center">
				<i class="bi bi-search text-text-faint mb-4 block text-4xl" />
				<p class="text-text-dim text-base">No se encontraron servidores.</p>
			</div>
		</section>
	</div>
</Layout>

<style is:global>
	/* Carga: un brillo que barre la tarjeta de izquierda a derecha, escalonado por
	   columnas para que no parpadeen todas a la vez. */
	.skeleton {
		background-color: rgb(255 255 255 / 0.05);
		background-image: linear-gradient(90deg, transparent 0%, rgb(255 255 255 / 0.08) 50%, transparent 100%);
		background-repeat: no-repeat;
		background-size: 60% 100%;
		background-position: -100% 0;
		animation: skeleton-sweep 1.5s ease-in-out infinite;
		animation-delay: calc(var(--i, 0) * 90ms);
	}

	@keyframes skeleton-sweep {
		to {
			background-position: 200% 0;
		}
	}

	/* Al llegar, cada tarjeta aparece con un leve ascenso. */
	.card-in {
		animation: card-in 0.35s ease-out both;
	}

	@keyframes card-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skeleton {
			animation: none;
			background-image: none;
		}
		.card-in {
			animation: none;
		}
	}
</style>

<script>
	import { escapeHtml } from "../scripts/support-ui";

	interface Guild {
		id: string;
		name: string;
		icon: string | null;
		members: number | null;
		protected: boolean;
		inviteUrl: string | null;
	}

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const grid = $("server-grid");
	const search = $<HTMLInputElement>("server-search");
	const emptyState = $("empty-state");
	const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");

	let activeFilter = "all";

	function cardHtml(g: Guild, i: number): string {
		const avatar = g.icon
			? `<img src="${escapeHtml(g.icon)}" alt="" class="h-11 w-11 shrink-0 rounded-full object-cover" />`
			: `<div class="bg-bg-soft text-text-dim border-border flex h-11 w-11 shrink-0 items-center justify-center rounded-full border text-base font-bold">${escapeHtml(g.name.charAt(0).toUpperCase())}</div>`;

		const badge = g.protected
			? `<span class="border-border bg-bg-soft text-text-dim inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold whitespace-nowrap"><span class="bg-emerald animate-status-pulse inline-block h-1.5 w-1.5 rounded-full"></span>Protegido 24/7</span>`
			: `<span class="border-border text-text-faint inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold whitespace-nowrap"><span class="bg-text-faint inline-block h-1.5 w-1.5 rounded-full"></span>Sin invitar</span>`;

		const stats = g.protected
			? `<div class="border-border-soft flex items-center gap-4 border-t pt-4 text-xs"><span class="text-text-dim"><span class="text-text font-bold">0</span> ataques bloqueados hoy</span><span class="text-text-dim"><span class="text-text font-bold">4/4</span> filtros activos</span></div>`
			: `<div class="border-border-soft border-t pt-4 text-xs"><span class="text-text-faint">El bot aún no está en este servidor</span></div>`;

		const action = g.protected
			? `<a href="/dashboard/${encodeURIComponent(g.id)}" class="border-border hover:border-brand hover:text-brand block rounded-[10px] border px-4 py-2.5 text-center text-sm font-bold transition-colors">Gestionar</a>`
			: `<a href="${escapeHtml(g.inviteUrl ?? "#")}" class="bg-brand hover:bg-brand-hover block rounded-[10px] px-4 py-2.5 text-center text-sm font-bold text-white transition-colors">Invitar bot</a>`;

		return `<div class="server-card card-in group border-border-soft bg-card hover:border-brand/50 flex h-full flex-col justify-between rounded-[14px] border p-5 transition-all duration-200 hover:-translate-y-[2px]" style="animation-delay:${Math.min(i, 11) * 40}ms" data-name="${escapeHtml(g.name.toLowerCase())}" data-status="${g.protected ? "protected" : "pending"}">
			<div>
				<div class="mb-4 flex items-start justify-between gap-2">
					<div class="flex min-w-0 flex-1 items-center gap-3">
						${avatar}
						<div class="min-w-0 flex-1">
							<h3 class="text-text truncate text-sm font-bold">${escapeHtml(g.name)}</h3>
							<p class="text-text-faint truncate text-xs">${g.members ? `${g.members.toLocaleString("es")} miembros` : escapeHtml(g.id)}</p>
						</div>
					</div>
					${badge}
				</div>
				${stats}
			</div>
			<div class="mt-4">${action}</div>
		</div>`;
	}

	function applyFilters() {
		const query = search.value.trim().toLowerCase();
		let visible = 0;

		grid.querySelectorAll<HTMLElement>(".server-card").forEach((card) => {
			const show = Boolean(card.dataset.name?.includes(query) && (activeFilter === "all" || card.dataset.status === activeFilter));
			card.classList.toggle("hidden", !show);
			if (show) visible++;
		});

		emptyState.classList.toggle("hidden", visible !== 0 || grid.hasAttribute("hidden"));
	}

	function show(guilds: Guild[]) {
		grid.setAttribute("aria-busy", "false");
		$("count-skeleton").hidden = true;
		const count = $("count");
		count.textContent = String(guilds.length);
		count.hidden = false;

		document.querySelector<HTMLElement>('[data-count="protected"]')!.textContent = `(${guilds.filter((g) => g.protected).length})`;
		document.querySelector<HTMLElement>('[data-count="pending"]')!.textContent = `(${guilds.filter((g) => !g.protected).length})`;

		if (!guilds.length) {
			grid.hidden = true;
			$("no-guilds").hidden = false;
			return;
		}
		grid.innerHTML = guilds.map(cardHtml).join("");
		applyFilters();
	}

	function fail() {
		grid.hidden = true;
		$("count-skeleton").hidden = true;
		$("load-error").hidden = false;
	}

	function load() {
		$("load-error").hidden = true;
		fetch("/api/dashboard/guilds", { headers: { Accept: "application/json" } })
			.then(async (res) => {
				// Sin sesión (o token caducado): a iniciarla.
				if (res.status === 401) return void (window.location.href = "/auth/discord/login");
				if (!res.ok) return fail();
				show(((await res.json()) as { guilds: Guild[] }).guilds);
			})
			.catch(fail);
	}

	search.addEventListener("input", applyFilters);

	filterButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeFilter = btn.dataset.filter || "all";
			filterButtons.forEach((b) => {
				const active = b === btn;
				b.classList.toggle("bg-text", active);
				b.classList.toggle("text-[#191919]", active);
				b.classList.toggle("border", !active);
				b.classList.toggle("border-border", !active);
				b.classList.toggle("text-text-dim", !active);
			});
			applyFilters();
		});
	});

	$("retry").addEventListener("click", () => {
		// Se vuelven a mostrar las tarjetas de carga mientras se reintenta.
		grid.hidden = false;
		grid.setAttribute("aria-busy", "true");
		$("count-skeleton").hidden = false;
		load();
	});

	load();
</script>
