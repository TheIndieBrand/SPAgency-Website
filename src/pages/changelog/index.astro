---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ChangelogEntry from "../../components/changelog/ChangelogEntry.astro";
import { listChangelogs } from "../../lib/changelog";
import { isOwner } from "../../lib/changelog-auth";
import { likeStates, likeTarget, noLikes } from "../../lib/likes";
import { getSessionUser } from "../../lib/session";

const entries = listChangelogs();

// El enlace a la administración solo se pinta si hay sesión y es el dueño.
// Sin cookie no se llama a Discord: la mayoría de visitas no pagan nada.
const user = await getSessionUser(Astro.cookies);
const owner = isOwner(user);

// Me gusta de todas las entradas de una vez (y cuáles ha dado quien mira).
const likes = likeStates("changelog:", user?.id);
---

<Layout
	title="Changelog — SP Agency"
	description="Novedades, mejoras y correcciones de SP Agency, versión a versión."
>
	<Navbar />

	<main class="mx-auto max-w-[920px] px-4 pt-16 pb-28 sm:px-8">
		<div class="mb-16">
			<div class="text-text-faint mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase">Changelog</div>
			<div class="flex flex-wrap items-end justify-between gap-4">
				<h1 class="font-display text-[38px] leading-tight font-bold tracking-tight">Novedades</h1>
				{
					owner && (
						<a
							href="/changelog/admin"
							class="border-border hover:border-brand hover:text-brand rounded-lg border px-4 py-2 text-sm font-bold transition-colors"
						>
							<i class="bi bi-pencil-square mr-1.5" />
							Administrar
						</a>
					)
				}
			</div>
			<p class="text-text-dim mt-3.5 text-base leading-relaxed">
				Todo lo que añadimos, mejoramos y arreglamos en SP Agency, de lo más reciente a lo más antiguo.
			</p>
		</div>

		{
			entries.length === 0 ? (
				<p class="text-text-faint py-16 text-base">Todavía no hay novedades publicadas.</p>
			) : (
				<div class="cl-timeline">
					{entries.map((entry, i) => (
						<ChangelogEntry
							name={entry.name}
							version={entry.version}
							subtitle={entry.subtitle}
							html={entry.html}
							publishedAt={entry.publishedAt}
							href={`/changelog/${entry.slug}`}
							latest={i === 0}
							like={{
								target: likeTarget.changelog(entry.id),
								...(likes.get(likeTarget.changelog(entry.id)) ?? noLikes),
								signedIn: Boolean(user),
							}}
						/>
					))}
				</div>
			)
		}
	</main>

	<Footer />
</Layout>
