---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { isStaff } from "../../lib/chat/staff";
import { MaxCommentLength } from "../../lib/CommunityTestimonials.constants";
import { communityTestimonialsRepository, type CommunityComment } from "../../lib/CommunityTestimonialsRepository";
import { getSessionUser } from "../../lib/session";
import { safeAvatar } from "../../lib/support-format";

const user = await getSessionUser(Astro.cookies);
if (!user) return Astro.redirect("/auth/discord/login?next=/staff/testimonials");
// Quien no es staff no debe ni saber que esta página existe.
if (!isStaff(user)) return Astro.redirect("/");

const pending = communityTestimonialsRepository.listByStatus("pending");
const approved = communityTestimonialsRepository.listByStatus("approved");
const rejected = communityTestimonialsRepository.listByStatus("rejected", 50);

const sections: Array<{
	key: string;
	title: string;
	empty: string;
	items: CommunityComment[];
	actions: Array<{ label: string; status: "approved" | "rejected" | "pending"; primary?: boolean }>;
}> = [
	{
		key: "pending",
		title: "Pendientes",
		empty: "No hay comentarios por revisar.",
		items: pending,
		actions: [
			{ label: "Aprobar", status: "approved", primary: true },
			{ label: "Rechazar", status: "rejected" },
		],
	},
	{
		key: "approved",
		title: "Publicados",
		empty: "Todavía no has aprobado ninguno.",
		items: approved,
		actions: [{ label: "Retirar", status: "rejected" }],
	},
	{
		key: "rejected",
		title: "Rechazados",
		empty: "Nada rechazado.",
		items: rejected,
		actions: [{ label: "Volver a pendiente", status: "pending" }],
	},
];

const fmt = (iso: string) =>
	new Date(iso).toLocaleString("es-ES", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }) + " UTC";
---

<Layout title="Testimonios de la comunidad — Staff" description="Panel interno de SP Agency.">
	<Navbar />

	<main id="staff-testimonials" class="mx-auto max-w-[900px] px-4 py-8 sm:px-8">
		<div class="mb-8">
			<div class="text-text-faint mb-2 text-[13px] font-bold tracking-[0.08em] uppercase">Staff</div>
			<h1 class="font-display text-[30px] leading-tight font-bold tracking-tight">Testimonios de la comunidad</h1>
			<p class="text-text-faint mt-2 max-w-[560px] text-[13px] leading-relaxed">
				Nada de lo que envía la gente se ve hasta que lo apruebas. Los aprobados aparecen solo en /testimonios, nunca
				en el home. Cada decisión queda guardada con tu ID.
			</p>
		</div>

		<p id="status" role="status" class="mb-4 min-h-5 text-sm text-red-400"></p>

		{
			sections.map((section) => (
				<section class="mb-12" aria-labelledby={`title-${section.key}`}>
					<h2 id={`title-${section.key}`} class="text-text-faint mb-3 text-[13px] font-bold tracking-[0.08em] uppercase">
						{section.title} <span class="text-text-dim">({section.items.length})</span>
					</h2>

					{section.items.length === 0 ? (
						<p class="text-text-faint py-4 text-sm">{section.empty}</p>
					) : (
						<ul class="divide-border-soft border-border-soft divide-y rounded-xl border">
							{section.items.map((c) => (
								<li class="flex gap-4 p-4 sm:p-5" data-id={c.id}>
									<img
										src={safeAvatar(c.avatar) ?? "https://cdn.discordapp.com/embed/avatars/0.png"}
										alt=""
										width="40"
										height="40"
										class="h-10 w-10 shrink-0 rounded-full object-cover"
									/>
									<div class="min-w-0 flex-1">
										<div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
											<span class="text-text text-sm font-bold">{c.displayName}</span>
											<span class="text-text-faint text-xs">@{c.username} · {c.userId}</span>
											<span class="text-text-faint text-xs">{fmt(c.createdAt)}</span>
										</div>
										<p class="text-text-dim mt-1.5 text-[14px] leading-relaxed break-words whitespace-pre-line">{c.comment}</p>
										<div class="mt-3 flex flex-wrap gap-2">
											{section.actions.map((a) => (
												<button
													type="button"
													data-status={a.status}
													class:list={[
														"rounded-lg px-3.5 py-1.5 text-[13px] font-bold transition-colors disabled:opacity-60",
														a.primary
															? "bg-brand hover:bg-brand-hover text-white"
															: "border-border text-text-dim hover:border-brand hover:text-brand border",
													]}
												>
													{a.label}
												</button>
											))}
										</div>
									</div>
								</li>
							))}
						</ul>
					)}
				</section>
			))
		}

		<p class="text-text-faint text-xs">Los comentarios admiten hasta {MaxCommentLength} caracteres, en texto plano.</p>
	</main>
</Layout>

<script>
	const root = document.getElementById("staff-testimonials")!;
	const status = document.getElementById("status")!;

	root.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-status]");
		const row = button?.closest<HTMLElement>("li[data-id]");
		if (!button || !row) return;

		button.disabled = true;
		status.textContent = "";

		try {
			const res = await fetch("/api/testimonials/review", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ id: Number(row.dataset.id), status: button.dataset.status }),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok) {
				status.textContent = data.message ?? "No se pudo guardar.";
				button.disabled = false;
				return;
			}
			window.location.reload();
		} catch {
			status.textContent = "No se pudo conectar. Inténtalo de nuevo.";
			button.disabled = false;
		}
	});
</script>
