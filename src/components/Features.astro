---
import { features, sections } from "../lib/home-content";

const copy = sections.features;
---

<section id="features" class="static-only mx-auto max-w-[1180px] px-8 pt-5 pb-[110px]">
	<div id="features-heading" class="mx-auto mb-14 max-w-[560px] text-center">
		<div class="text-text-faint mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase">{copy.eyebrow}</div>
		<h2 class="font-display mb-3.5 text-[38px] font-bold tracking-tight">{copy.title}</h2>
		<p class="text-text-dim text-base leading-relaxed">{copy.subtitle}</p>
	</div>

	<div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
		{
			features.map((f) => (
				<div class="border-border-soft bg-card hover:border-border hover:bg-card-hover rounded-[14px] border p-7 transition-colors duration-200">
					<div class="border-border text-text mb-5 flex h-11 w-11 items-center justify-center rounded-[10px] border text-xl">
						<i class={`bi ${f.icon}`} />
					</div>
					<h3 class="mb-2 text-[17px] font-bold">{f.title}</h3>
					<p class="text-text-dim text-sm leading-relaxed">{f.desc}</p>
				</div>
			))
		}
	</div>
</section>
