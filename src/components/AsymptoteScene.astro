---
import BlackHole from "./BlackHole.astro";
import TestimonialCard from "./TestimonialCard.astro";
import { testimonials } from "../lib/testimonials";
import { steps } from "../lib/steps";

// Segundo acto de la escena de scroll (ver src/scripts/intro-scene.ts):
//
// 1. Aparece "lim" con "x ⟶ ∞" como subíndice, en el hueco que dejaba el
//    título del hero.
// 2. El título "89K+ Raids bloqueados" se FORMA a partir de la grilla de
//    stats: el script despega el número y la etiqueta REALES de la segunda
//    celda de <Stats/> (no un clon) y los recoloca, ya "formados", debajo
//    del límite. Mientras se recoloca: aparecen más símbolos matemáticos por
//    toda la pantalla, el radar gira un poco más y las otras casillas de
//    stats se separan y caen desvaneciéndose.
// 3. El número se encoge y viaja hasta ocupar la "x" del límite (que se
//    desvanece); la etiqueta "Raids bloqueados" se queda quieta donde estaba.
// 4. Desenlace: el "89K+" se dispara contando hasta un número titánico y el ∞
//    empieza a temblar pronto, cada vez más fuerte. Entonces el ∞ ESTALLA:
//    desaparece y su onda expansiva se lleva por delante el radar, el bloque
//    del límite y el título "89K+ Raids bloqueados" — salen despedidos y se
//    desintegran en partículas azules y blancas que se arrastran hacia fuera.
//    De ese punto estallado emerge el plano cartesiano, un círculo que crece
//    desde el infinito hasta ocupar toda la pantalla, y la curva crece. Solo
//    queda el plano (y los símbolos tenues del fondo). El límite NO crece.

// Símbolos que aparecen repartidos por toda la pantalla durante el Acto 2
// (los revela el script con un stagger). Puramente ambientales.
const extraGlyphs = [
	{ text: "∫", x: 12, y: 16, size: 30, tone: "brand" },
	{ text: "∂x", x: 78, y: 10, size: 15, tone: "text" },
	{ text: "Σⁿ", x: 6, y: 62, size: 20, tone: "brand" },
	{ text: "√n", x: 90, y: 30, size: 16, tone: "text" },
	{ text: "π", x: 40, y: 6, size: 22, tone: "text" },
	{ text: "∇·F", x: 66, y: 84, size: 14, tone: "brand" },
	{ text: "e^x", x: 20, y: 88, size: 15, tone: "text" },
	{ text: "≈", x: 52, y: 40, size: 26, tone: "brand" },
	{ text: "dx", x: 84, y: 54, size: 14, tone: "text" },
	{ text: "λ", x: 4, y: 34, size: 24, tone: "brand" },
	{ text: "n!", x: 30, y: 70, size: 15, tone: "text" },
	{ text: "∮", x: 94, y: 74, size: 20, tone: "brand" },
	{ text: "θ", x: 58, y: 18, size: 18, tone: "text" },
	{ text: "f(x)", x: 14, y: 48, size: 14, tone: "text" },
	{ text: "→0", x: 46, y: 92, size: 14, tone: "brand" },
	{ text: "⌊x⌋", x: 72, y: 40, size: 14, tone: "text" },
	{ text: "Δt", x: 34, y: 30, size: 16, tone: "brand" },
	{ text: "∞", x: 88, y: 90, size: 22, tone: "brand" },
];

// Partículas del estallido: el script las reparte entre el ∞, el radar y el
// bloque del límite y las dispara hacia fuera. Azules y blancas alternadas,
// tamaños variados.
const burstDots = Array.from({ length: 26 }, (_, i) => ({
	size: 4 + (i % 4) * 2,
	blue: i % 2 === 0,
}));

// Tarjetas de "Funciones" que suben apiladas en el tramo espacio. (Mismo
// contenido que <Features/>; de momento duplicado.)
const spaceCards = [
	{
		icon: "bi-broadcast-pin",
		title: "Detección de raids en tiempo real",
		desc: "Analiza patrones de entrada y bloquea oleadas de cuentas antes de que actúen.",
	},
	{
		icon: "bi-patch-check",
		title: "Verificación de cuentas",
		desc: "Filtra cuentas nuevas, sin avatar o sospechosas con reglas configurables.",
	},
	{
		icon: "bi-funnel",
		title: "Anti-spam inteligente",
		desc: "Detecta mensajes masivos, menciones y enlaces maliciosos al instante.",
	},
	{
		icon: "bi-file-earmark-text",
		title: "Registros de seguridad",
		desc: "Historial detallado de cada acción para auditar lo que pasó y cuándo.",
	},
	{
		icon: "bi-cpu",
		title: "Auto-moderación con IA",
		desc: "Modelos entrenados para distinguir tráfico legítimo de ataques coordinados.",
	},
	{
		icon: "bi-speedometer2",
		title: "Panel de control web",
		desc: "Configura umbrales, whitelist y alertas sin tocar comandos.",
	},
];
---

<div id="asymptote-scene" class="pointer-events-none absolute inset-0 z-10 overflow-hidden opacity-0" aria-hidden="true">
	<!-- Tramo "espacio" (fase B): overlay negro que tapa el gris de la página y
	     capa de estrellas de fondo. Ambos arrancan invisibles. -->
	<div id="space-bg" class="absolute inset-0 bg-black opacity-0"></div>
	<!-- Estrellas de fondo (tramo "espacio"). Se dibujan en un <canvas> como campo
	     INFINITO (ver star-field.ts): la cámara del acto final puede ir tan lejos
	     como haga falta. #space-stars es solo el controlador de estado que ya
	     animaban los tweens (opacidad y bajada del ascenso); el canvas lo lee. -->
	<div id="space-stars" class="hidden opacity-0" aria-hidden="true"></div>
	<canvas id="space-stars-canvas" class="absolute inset-0 h-full w-full"></canvas>

	<svg
		id="asymptote-grid"
		class="absolute inset-0 h-full w-full"
		viewBox="0 0 1000 600"
		preserveAspectRatio="none"
	>
		<defs>
			<pattern id="cartesian-cell" width="40" height="40" patternUnits="userSpaceOnUse">
				<path d="M40 0 L0 0 0 40" fill="none" stroke="#0079bb" stroke-opacity="0.16" stroke-width="1"></path>
			</pattern>
		</defs>

		<!-- El script traslada este grupo (cámara-follow) durante el "viaje" por
		     el eje X. La rejilla y los ejes son MUCHO más anchos que el viewBox
		     para no quedarse cortos durante el paneo; terminan hacia x≈5400
		     a propósito, para que el plano "se acabe" en el estallido final. -->
		<g id="asymptote-drift">
			<!-- La rejilla y los ejes (que se apagan en el salto al espacio). La
			     CURVA va aparte, fuera de este grupo, para que no se desvanezca
			     con ella: la función nunca desaparece. -->
			<g id="grid-lines">
				<rect x="-600" y="-600" width="6000" height="2400" fill="url(#cartesian-cell)"></rect>
				<line x1="-600" y1="560" x2="5400" y2="560" stroke="#0079bb" stroke-opacity="0.4" stroke-width="1.5"></line>
				<line x1="40" y1="-600" x2="40" y2="1800" stroke="#0079bb" stroke-opacity="0.4" stroke-width="1.5"></line>
			</g>

			<!-- Curva + proyecciones + punta. Al final el script rota ESTE grupo
			     sobre la propia punta para tumbar la función hacia arriba. -->
			<g id="curve-tilt">
			<!-- curva exponencial: tendida y casi pegada al eje X durante un
			     tramo larguísimo (el "viaje"), luego se dispara casi vertical y
			     SIGUE subiendo sin fin (tramo larguísimo hasta y≈-9000): nunca
			     se termina de dibujar → sensación de crecer hacia el infinito -->
			<path
				id="asymptote-curve"
				d="M 40 558 C 900 553, 1900 543, 2600 520 C 3200 500, 3700 468, 4050 420 C 4300 385, 4480 320, 4600 232 C 4720 150, 4830 10, 4910 -260 C 4980 -520, 5030 -1000, 5060 -1650 C 5085 -2300, 5108 -3600, 5124 -5200 C 5136 -6400, 5144 -7700, 5150 -9000"
				fill="none"
				stroke="#0079bb"
				stroke-width="3"
				stroke-linecap="round"
			></path>

			<!-- proyecciones de la punta a los ejes: vertical roja hasta el eje X
			     (representa x0) y horizontal ámbar hasta el eje Y (representa
			     y0). Finas y punteadas; el script fija sus extremos cada frame. -->
			<g id="curve-proj" opacity="0">
				<line
					id="curve-proj-x"
					stroke="#ef4444"
					stroke-width="1.3"
					stroke-dasharray="5 5"
					vector-effect="non-scaling-stroke"
				></line>
				<line
					id="curve-proj-y"
					stroke="#f5b301"
					stroke-width="1.3"
					stroke-dasharray="5 5"
					vector-effect="non-scaling-stroke"
				></line>
			</g>

			<!-- punta de la función: puntito blanco sutil (núcleo + halo). En el
			     tramo "espacio" el script hace crossfade a la estrellita. -->
			<g id="asymptote-curve-head" opacity="0">
				<circle r="8" fill="#eeeeee" opacity="0.08"></circle>
				<circle id="curve-head-dot" r="3" fill="#eeeeee" opacity="0.72"></circle>
				<!-- La estrella va envuelta en su propio <g> (#curve-head-star):
				     el script rota ESE grupo, así gira limpia sobre (0,0). -->
				<g id="curve-head-star" opacity="0">
					<path
						fill="#eeeeee"
						d="M 0 -8 Q 1.5 -1.5 8 0 Q 1.5 1.5 0 8 Q -1.5 1.5 -8 0 Q -1.5 -1.5 0 -8 Z"
					></path>
				</g>
			</g>
			</g>
		</g>
	</svg>

	<!-- Notación de límite propiamente dicha: "lim" recto (es un operador, no
	     una variable) con "x ⟶ ∞" como subíndice centrado justo debajo. La
	     variable va en cursiva serif (convención matemática) y el ∞ lleva un
	     leve halo azul que respira, para que enganche con la estética del
	     radar. La posición (fixed) la calcula el script a partir del rect real
	     del título del hero. #limit-x se mantiene como caja medible: el número
	     de "Raids bloqueados" viaja hasta centrarse sobre él. -->
	<div id="limit-block" class="text-left opacity-0">
		<div class="inline-flex flex-col items-center">
			<span class="font-display text-text text-[104px] leading-[0.8] font-semibold tracking-[-0.03em]">
				lim
			</span>
			<span class="mt-1 flex items-center gap-2.5 text-[28px] leading-none">
				<span id="limit-x" class="text-text inline-block min-w-[1.2em] text-center font-serif text-[31px] italic">
					x
				</span>
				<span id="limit-arrow" class="text-text-faint text-[23px]">&#10230;</span>
				<span id="limit-infinity-shake" class="limit-infinity-shake inline-block">
					<span class="limit-infinity text-brand text-[35px]">&#8734;</span>
				</span>
			</span>
		</div>
	</div>

	<!-- El título "89K+ Raids bloqueados" no vive aquí: el script lo forma
	     despegando el número y la etiqueta REALES de la segunda celda de
	     <Stats/> y recolocándolos debajo del límite. -->

	<!-- Capa de símbolos extra repartidos por toda la pantalla. Arrancan
	     invisibles; el script los revela con un stagger durante el Acto 2 y la
	     desplaza (con parallax) al mover la cámara por el plano. -->
	<div id="asymptote-glyph-layer" class="pointer-events-none absolute inset-0 font-mono select-none" aria-hidden="true">
		{
			extraGlyphs.map((g) => (
				<span
					class="asymptote-glyph absolute leading-none whitespace-nowrap opacity-0"
					style={`left:${g.x}%; top:${g.y}%; font-size:${g.size}px; color:${g.tone === "brand" ? "#0079bb" : "#eeeeee"};`}
				>
					{g.text}
				</span>
			))
		}
	</div>

	<!-- Partículas del estallido del ∞ (desenlace). El script las coloca sobre
	     el ∞ y las dispara hacia los bordes; arrancan invisibles. -->
	<div id="limit-burst" class="pointer-events-none fixed inset-0" aria-hidden="true">
		{
			burstDots.map((d) => (
				<span
					class="limit-burst-dot absolute opacity-0"
					style={`width:${d.size}px; height:${d.size}px; background:${d.blue ? "#0079bb" : "#eeeeee"};`}
				/>
			))
		}
	</div>

	<!-- Titulares de la esquina sup-izq durante el "viaje" por la función. El
	     script los enciende/apaga en secuencia. Sin borde ni recuadro: solo un
	     fondo semitransparente y una sombra ANCHA del mismo color de fondo que
	     difumina los bordes, para que la rejilla no moleste tras el texto pero
	     el "card" no se note. -->
	<div id="travel-captions" class="pointer-events-none fixed top-32 left-20 h-32 w-[400px]" aria-hidden="true">
		<p
			id="travel-caption-1"
			class="font-display text-text bg-bg/85 absolute top-0 left-0 w-full px-4 py-3 text-[23px] leading-snug font-semibold opacity-0 shadow-[0_0_45px_38px_rgba(25,25,25,0.82)] [text-shadow:0_1px_10px_rgba(0,0,0,0.8)]"
		>
			<span class="text-brand">SP Agency</span>, obra de ingeniería.
		</p>
		<p
			id="travel-caption-2"
			class="font-display text-text bg-bg/85 absolute top-0 left-0 w-full px-4 py-3 text-[23px] leading-snug font-semibold opacity-0 shadow-[0_0_45px_38px_rgba(25,25,25,0.82)] [text-shadow:0_1px_10px_rgba(0,0,0,0.8)]"
		>
			Latencia estudiada al milisegundo.
		</p>
	</div>

	<!-- Valores numéricos de las proyecciones x0 / y0. Fuera del SVG para que
	     no los deforme el preserveAspectRatio; el script los coloca en la
	     intersección de cada proyección con su eje. -->
	<div id="curve-proj-labels" class="pointer-events-none fixed inset-0 font-mono text-[13px] opacity-0" aria-hidden="true">
		<span
			id="curve-proj-x-label"
			class="absolute top-0 left-0 text-[#ef4444]"
			style="text-shadow:0 1px 6px rgba(0,0,0,0.9)"
		></span>
		<span
			id="curve-proj-y-label"
			class="absolute top-0 left-0 text-[#f5b301]"
			style="text-shadow:0 1px 6px rgba(0,0,0,0.9)"
		></span>
	</div>

	<!-- Agujero negro (WebGL) que se cruza en el tramo final: entra por la
	     derecha, BAJO (solo asoma la mitad superior), y la "cámara" pasa de
	     largo → deriva a la izquierda y sale. Arriba, la asíntota sigue
	     avanzando. El script (intro-scene.ts) lo posiciona y anima.
	     Va ANTES (debajo) de la asíntota y de la comunidad en el DOM: su canvas
	     es opaco y cuadrado (1400px), taparía todo lo que quedase detrás. -->
	<div id="outro-blackhole" class="pointer-events-none fixed left-1/2 top-1/2 opacity-0" aria-hidden="true">
		<BlackHole size={1400} />
	</div>

	<!-- Asíntota del cuadro final. En el outro, la curva del plano (dentro del
	     SVG deformado por preserveAspectRatio="none") se marcha hacia abajo y
	     ESTA la sustituye. Contenedor a pantalla completa. Es UN solo trazo SVG
	     (en píxeles, sin viewBox) que el script construye a la medida del
	     viewport (intro-scene.ts, layoutOutro): recta horizontal que nace fuera
	     de pantalla por la izquierda, un arco hacia abajo (la atracción del
	     agujero negro) y una recta vertical larga. Se DIBUJA con
	     stroke-dashoffset (no escala → no se estira) hasta la punta.
	     Todo va dentro de #outro-world, un grupo en coordenadas del MUNDO al que
	     el script aplica la cámara:
	       · #route-dots: el camino punteado que une los pasos ("lo que falta").
	       · #outro-path: el trazo de la asíntota. Blanco hasta el primer paso y
	         azul de marca a partir de ahí (degradado #route-grad): es el camino
	         que se va completando sobre el punteado. -->
	<div id="outro-line" class="pointer-events-none fixed inset-0 opacity-0" aria-hidden="true">
		<svg
			class="absolute inset-0 h-full w-full overflow-visible"
			style="filter: drop-shadow(0 0 5px rgba(180, 215, 255, 0.4))"
			fill="none"
		>
			<defs>
				<linearGradient id="route-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="#eeeeee"></stop>
					<stop offset="1" stop-color="#2aa4f0"></stop>
				</linearGradient>
			</defs>
			<g id="outro-world">
				<path
					id="route-dots"
					stroke="#6e6e6e"
					stroke-width="3"
					stroke-linecap="round"
					stroke-dasharray="0.1 11"
					fill="none"></path>
				<path id="outro-path" stroke="url(#route-grad)" stroke-linecap="butt" stroke-linejoin="round" fill="none"></path>
			</g>
		</svg>
	</div>

	<!-- ============ Acto final: la comunidad ============ -->
	<!-- Cuando el agujero negro ya se ha ido por la izquierda, suben desde abajo,
	     en carrusel, los testimonios — centrados en la pantalla, con la
	     asíntota cayendo a su derecha; el fondo y la asíntota siguen su
	     movimiento (la cámara baja con ella). Encabezado fijo arriba y
	     centrado; las tarjetas suben por una ventana con máscara (se funden bajo
	     el encabezado en vez de pisarlo). Los 9 testimonios de
	     src/lib/testimonials.ts. -->
	<div id="community" class="pointer-events-none fixed inset-0 opacity-0" aria-hidden="true">
		<div id="community-heading" class="absolute top-[9vh] left-1/2 w-[min(90vw,520px)] -translate-x-1/2 text-center">
			<div class="text-text-faint mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase">Testimonios</div>
			<h2 class="font-display text-text text-[38px] leading-[1.12] font-bold tracking-tight">Lo que dice la comunidad</h2>
		</div>
		<div
			id="community-window"
			class="absolute top-[27vh] bottom-0 left-1/2 w-[420px] -translate-x-1/2 overflow-hidden"
			style="-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16%); mask-image: linear-gradient(to bottom, transparent 0, #000 16%)"
		>
			<div id="community-track" class="flex flex-col items-center gap-5">
				{testimonials.map((t) => <TestimonialCard testimonial={t} />)}
			</div>
		</div>
	</div>

	<!-- ============ Acto de los pasos: "Configurado en tres pasos" ============ -->
	<!-- Cada paso es un NODO del camino que sigue la asíntota: nace como un aro
	     punteado que sube desde abajo por el eje central; cuando la punta lo toca
	     se completa (relleno, aro continuo, onda expansiva, chispas) y salen sus
	     textos con un shake cada vez más fuerte. El script (steps-act.ts) coloca
	     los nodos en coordenadas del mundo y dispara los efectos. Los textos se
	     alternan a derecha e izquierda del eje. Datos en src/lib/steps.ts. -->
	<div id="steps-world" class="pointer-events-none fixed inset-0" aria-hidden="true">
		<svg width="0" height="0" class="absolute">
			<defs>
				<radialGradient id="step-fill-grad" gradientUnits="userSpaceOnUse" cx="36" cy="36" r="33">
					<stop offset="0" stop-color="#4db3f4"></stop>
					<stop offset="1" stop-color="#0079bb"></stop>
				</radialGradient>
			</defs>
		</svg>
		{
			steps.map((s, i) => (
				<div class="step-node absolute top-0 left-0" data-step={i} data-side={i % 2 === 0 ? "right" : "left"} style="visibility:hidden">
					<div class="step-glow absolute top-[-62px] left-[-62px] h-[124px] w-[124px] rounded-full opacity-0"></div>
					<div class="step-shock absolute top-[-36px] left-[-36px] h-[72px] w-[72px] rounded-full opacity-0"></div>
					<div class="step-shock absolute top-[-36px] left-[-36px] h-[72px] w-[72px] rounded-full opacity-0"></div>
					<svg viewBox="0 0 72 72" class="step-svg absolute top-[-36px] left-[-36px] h-[72px] w-[72px] overflow-visible">
						<circle cx="36" cy="36" r="33" fill="#000"></circle>
						<circle
							class="ring-dash"
							cx="36"
							cy="36"
							r="33"
							fill="none"
							stroke="#6e6e6e"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-dasharray="0.01 7.4"
						></circle>
						<circle
							class="ring-fill"
							cx="36"
							cy="36"
							r="16.5"
							fill="none"
							stroke="url(#step-fill-grad)"
							stroke-width="33"
							pathLength="1"
							stroke-dasharray="1"
							stroke-dashoffset="1"
							transform="rotate(-90 36 36)"
						></circle>
						<circle
							class="ring-solid"
							cx="36"
							cy="36"
							r="33"
							fill="none"
							stroke="#59baf5"
							stroke-width="2.6"
							stroke-linecap="round"
							pathLength="1"
							stroke-dasharray="1"
							stroke-dashoffset="1"
							transform="rotate(-90 36 36)"
						></circle>
						<text
							class="ring-num font-display"
							x="36"
							y="37"
							text-anchor="middle"
							dominant-baseline="central"
							fill="#9b9b9b"
							font-size="28"
							font-weight="700"
						>
							{s.n}
						</text>
					</svg>
					{Array.from({ length: 14 }, () => <span class="step-spark absolute top-[-2px] left-[-2px] h-1 w-1 rounded-full opacity-0" />)}
					<div
						class:list={[
							"step-text absolute top-0 w-[320px] -translate-y-1/2 opacity-0",
							i % 2 === 0 ? "left-[62px] text-left" : "right-[62px] text-right",
						]}
					>
						<div class="step-text-inner">
							<h3 class="font-display text-[24px] leading-tight font-bold text-white">{s.title}</h3>
							<p class="text-text-dim mt-2 text-[15px] leading-relaxed">{s.desc}</p>
						</div>
					</div>
				</div>
			))
		}
	</div>

	<!-- La estrellita = la PUNTA de la asíntota; el script la coloca en el
	     extremo dibujado del trazo cada frame. Va en su PROPIA capa, por encima
	     de los pasos: al tocar el primero se "absorbe" dentro del círculo y tiene
	     que verse sobre él. -->
	<div id="outro-star-layer" class="pointer-events-none fixed inset-0 opacity-0" aria-hidden="true">
		<!-- Misma estrellita (y mismo tamaño) que la punta de la curva del plano:
		     viewBox centrado en (0,0) y con 1 unidad = vw/1000, igual que la
		     escala X del SVG del plano → el trazo ±8 rinde a 16·vw/1000 px, como
		     el original en cualquier ancho de pantalla. -->
		<svg id="outro-line-star" class="absolute top-0 left-0 h-[2.4vw] w-[2.4vw] overflow-visible" viewBox="-12 -12 24 24" fill="none">
			<circle r="8" fill="#eeeeee" opacity="0.1"></circle>
			<path
				fill="#eeeeee"
				opacity="0.85"
				d="M 0 -8 Q 1.5 -1.5 8 0 Q 1.5 1.5 0 8 Q -1.5 1.5 -8 0 Q -1.5 -1.5 0 -8 Z"
			></path>
		</svg>
	</div>

	<!-- ============ Inmersión: caída al agujero negro ============ -->
	<!-- Capas del final (las mueve el script, ver renderOutro en intro-scene.ts).
	     Van por encima del agujero negro, los pasos y la asíntota:
	       · #dive-vignette: oscurece los bordes según nos acercamos.
	       · #dive-black: negro total cuando estamos dentro.
	       · #dive-spark / #dive-bloom: del negro reaparece un punto de luz (la
	         estrella de la punta) que se expande hasta dar paso a la CTA (que es
	         un elemento real fuera de esta escena aria-hidden: SceneCta.astro). -->
	<div id="dive-vignette" class="pointer-events-none fixed inset-0 opacity-0" aria-hidden="true"
		style="background: radial-gradient(ellipse at center, rgba(0,0,0,0) 30%, rgba(0,0,0,0.55) 68%, #000 100%)"></div>
	<div id="dive-black" class="pointer-events-none fixed inset-0 bg-black opacity-0" aria-hidden="true"></div>
	<div id="dive-bloom" class="pointer-events-none fixed top-1/2 left-1/2 h-[64px] w-[64px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-0" aria-hidden="true"
		style="background: radial-gradient(circle, rgba(255,255,255,0.95) 0%, rgba(120,190,255,0.55) 22%, rgba(0,121,187,0.28) 48%, rgba(0,121,187,0) 72%)"></div>
	<div id="dive-spark" class="pointer-events-none fixed top-1/2 left-1/2 h-[10px] w-[10px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white opacity-0" aria-hidden="true"
		style="box-shadow: 0 0 18px 6px rgba(190,225,255,0.85), 0 0 60px 18px rgba(0,147,228,0.45)"></div>

	<!-- ============ Tramo ESPACIO → sección Funciones ============ -->
	<!-- Aparece sobre el fondo negro estrellado mientras la exponencial sigue
	     creciendo a la izquierda. El script lo maneja dentro del pin. -->
	<div id="space-features" class="pointer-events-none fixed inset-0 opacity-0" aria-hidden="true">
		<!-- Luna: entra desde arriba y cruza hasta abajo (sensación de seguir
		     subiendo). Va detrás de todo y a media opacidad → se ve lejana. -->
		<div id="moon" class="absolute top-0 left-1/2 -z-10 -translate-x-1/2 opacity-0 blur-[1px]">
			<svg width="150" height="150" viewBox="0 0 220 220" fill="none">
				<defs>
					<radialGradient id="moonBody" cx="37%" cy="33%" r="78%">
						<stop offset="0%" stop-color="#f6f4ec" />
						<stop offset="46%" stop-color="#d3d6dd" />
						<stop offset="78%" stop-color="#8b909d" />
						<stop offset="100%" stop-color="#565b69" />
					</radialGradient>
					<radialGradient id="moonShade" cx="30%" cy="25%" r="100%">
						<stop offset="0%" stop-color="#05060a" stop-opacity="0" />
						<stop offset="60%" stop-color="#05060a" stop-opacity="0" />
						<stop offset="100%" stop-color="#05060a" stop-opacity="0.6" />
					</radialGradient>
					<radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#cdd6ff" stop-opacity="0.32" />
						<stop offset="62%" stop-color="#cdd6ff" stop-opacity="0.06" />
						<stop offset="100%" stop-color="#cdd6ff" stop-opacity="0" />
					</radialGradient>
					<radialGradient id="crater" cx="40%" cy="36%" r="70%">
						<stop offset="0%" stop-color="#666c79" />
						<stop offset="55%" stop-color="#969cab" />
						<stop offset="100%" stop-color="#b7bcc7" />
					</radialGradient>
					<clipPath id="moonClip"><circle cx="110" cy="110" r="80" /></clipPath>
				</defs>
				<circle cx="110" cy="110" r="108" fill="url(#moonGlow)" />
				<circle cx="110" cy="110" r="80" fill="url(#moonBody)" />
				<g clip-path="url(#moonClip)">
					<ellipse cx="84" cy="78" rx="16" ry="15" fill="url(#crater)" opacity="0.9" />
					<ellipse cx="134" cy="102" rx="10" ry="9" fill="url(#crater)" opacity="0.85" />
					<ellipse cx="99" cy="143" rx="19" ry="17" fill="url(#crater)" opacity="0.82" />
					<ellipse cx="145" cy="152" rx="7" ry="6.5" fill="url(#crater)" opacity="0.8" />
					<ellipse cx="70" cy="120" rx="6" ry="5.5" fill="url(#crater)" opacity="0.78" />
					<ellipse cx="120" cy="60" rx="5" ry="4.5" fill="url(#crater)" opacity="0.72" />
					<circle cx="150" cy="86" r="26" fill="#ffffff" opacity="0.05" />
					<circle cx="78" cy="150" r="20" fill="#000000" opacity="0.06" />
				</g>
				<circle cx="110" cy="110" r="80" fill="url(#moonShade)" />
				<circle cx="110" cy="110" r="80" fill="none" stroke="#eef0f5" stroke-opacity="0.14" stroke-width="1" />
			</svg>
		</div>

		<!-- Título + subtítulo, centrados. El subtítulo se va y el título sube. -->
		<div id="space-features-heading" class="absolute top-[36%] left-1/2 w-[680px] max-w-[88vw] -translate-x-1/2 text-center opacity-0">
			<div class="text-text-faint mb-4 text-[13px] font-bold tracking-[0.1em] uppercase">Funciones</div>
			<h2 class="font-display text-text text-[46px] leading-[1.12] font-bold tracking-tight">
				Todo lo que necesitas para dormir tranquilo
			</h2>
			<p id="space-features-sub" class="text-text-dim mx-auto mt-5 max-w-[520px] text-[17px] leading-relaxed">
				Un sistema de defensa completo, configurable en minutos y sin tocar código.
			</p>
		</div>

		<!-- Los 6 cards: rejilla centrada bajo el título. Oscuros y translúcidos
		     para asentarse sobre el fondo estrellado; flotan suavemente. -->
		<div id="space-features-cards" class="absolute top-[43%] left-1/2 grid w-[900px] max-w-[92vw] -translate-x-1/2 grid-cols-1 gap-4 opacity-0 sm:grid-cols-2 lg:grid-cols-3">
			{
				spaceCards.map((f, i) => (
					<div
						class="space-card rounded-2xl border border-white/[0.09] bg-white/[0.035] p-5 shadow-[0_16px_50px_-16px_rgba(0,0,0,0.7)] backdrop-blur-[2px]"
						style={`animation-delay:${(i * 0.55).toFixed(2)}s`}
					>
						<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-[10px] border border-white/15 text-lg text-white/80">
							<i class={`bi ${f.icon}`} />
						</div>
						<h3 class="text-text mb-1.5 text-[16px] font-bold">{f.title}</h3>
						<p class="text-text-dim text-[13.5px] leading-relaxed">{f.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</div>

<style>
	.limit-burst-dot {
		border-radius: 9999px;
		will-change: transform, opacity;
	}

	/* Flotación suave de los cards de Funciones (el desfase lo da el
	   animation-delay inline de cada card). La entrada la anima el script sobre
	   el contenedor, así que no colisiona con este transform. */
	.space-card {
		animation: space-card-float 5s ease-in-out infinite;
	}

	@keyframes space-card-float {
		0%,
		100% {
			transform: translateY(-5px);
		}
		50% {
			transform: translateY(5px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.space-card {
			animation: none;
		}
	}

	/* Halo azul suave sobre el ∞ que respira lentamente — mismo lenguaje
	   visual que el brillo del radar. El script solo toca opacity/scale/x de
	   #limit-block (ancestro), así que esta animación no colisiona. */
	.limit-infinity {
		display: inline-block;
		text-shadow: 0 0 22px color-mix(in oklab, var(--color-brand) 45%, transparent);
		animation: limit-infinity-breathe 4.5s ease-in-out infinite;
	}

	@keyframes limit-infinity-breathe {
		0%,
		100% {
			opacity: 0.82;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.06);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.limit-infinity {
			animation: none;
			opacity: 1;
		}
	}

	/* Temblor del ∞ en el desenlace: la animación corre siempre en tiempo real
	   (no ligada al scroll), pero su amplitud la controla el script subiendo
	   --tremble de 0 a 1. Con --tremble:0 no se mueve. */
	.limit-infinity-shake {
		animation: limit-infinity-shake 130ms steps(2, jump-none) infinite;
	}

	@keyframes limit-infinity-shake {
		0%,
		100% {
			transform: translate(0, 0) rotate(0deg);
		}
		25% {
			transform: translate(calc(var(--tremble, 0) * -1.6px), calc(var(--tremble, 0) * 1.1px))
				rotate(calc(var(--tremble, 0) * -1.4deg));
		}
		50% {
			transform: translate(calc(var(--tremble, 0) * 1.5px), calc(var(--tremble, 0) * -1.3px))
				rotate(calc(var(--tremble, 0) * 1.2deg));
		}
		75% {
			transform: translate(calc(var(--tremble, 0) * -1px), calc(var(--tremble, 0) * -1.5px))
				rotate(calc(var(--tremble, 0) * 0.9deg));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.limit-infinity-shake {
			animation: none;
		}
	}

	/* Nodos de los pasos (ver steps-act.ts). El aro punteado gira despacio
	   mientras el paso está pendiente; al completarse lo apaga el script. */
	.step-node {
		will-change: transform;
	}

	.step-glow {
		background: radial-gradient(
			circle,
			rgba(0, 147, 228, 0.55) 0%,
			rgba(0, 121, 187, 0.18) 45%,
			rgba(0, 121, 187, 0) 70%
		);
	}

	.step-shock {
		border: 2px solid #4db3f4;
	}

	.ring-dash {
		transform-box: fill-box;
		transform-origin: center;
		animation: ring-spin 42s linear infinite;
	}

	@keyframes ring-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ring-dash {
			animation: none;
		}
	}
</style>
