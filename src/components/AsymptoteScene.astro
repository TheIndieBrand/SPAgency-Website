---
import BlackHole from "./BlackHole.astro";
import SpaceBackdrop from "./scene/SpaceBackdrop.astro";
import CartesianPlane from "./scene/CartesianPlane.astro";
import LimitBlock from "./scene/LimitBlock.astro";
import AsymptoteGlyphs from "./scene/AsymptoteGlyphs.astro";
import BurstDots from "./scene/BurstDots.astro";
import TravelCaptions from "./scene/TravelCaptions.astro";
import ProjectionLabels from "./scene/ProjectionLabels.astro";
import OutroLine from "./scene/OutroLine.astro";
import CommunityCarousel from "./scene/CommunityCarousel.astro";
import StepsWorld from "./scene/StepsWorld.astro";
import OutroStar from "./scene/OutroStar.astro";
import DiveLayers from "./scene/DiveLayers.astro";
import SpaceFeatures from "./scene/SpaceFeatures.astro";

// second act of the scroll scene (see src/scripts/intro-scene.ts):
//
// 1. "lim" appears with "x ⟶ ∞" as a subscript, in the gap the hero's title left behind.
// 2. the "89K+ Raids bloqueados" title FORMS out of the stats grid: the
//    script detaches the REAL number and label from <Stats/>'s second cell
//    (not a clone) and repositions them, already "formed", below the limit.
//    while it repositions: more math symbols appear across the whole
//    screen, the radar spins a bit more, and the other stat cells separate and fall away fading out.
// 3. the number shrinks and travels to occupy the limit's "x" (which fades
//    out); the "Raids bloqueados" label stays put where it was.
// 4. climax: the "89K+" shoots up counting to a titanic number and the ∞
//    starts shaking early on, growing stronger. then the ∞ BURSTS: it
//    disappears and its shockwave sweeps away the radar, the limit block
//    and the "89K+ Raids bloqueados" title — they fly off and disintegrate
//    into blue and white particles dragged outward. from that burst point
//    the cartesian plane emerges, a circle growing from infinity until it
//    fills the whole screen, and the curve grows. only the plane is left
//    (plus the faint background symbols). the limit does NOT grow.
//
// each layer lives in its own component (src/components/scene/). the ORDER
// below is the dom order and it matters: it's the stacking order (for
// example, the black hole comes before the asymptote and the community
// because its canvas is opaque) and shouldn't be changed without checking the scene.
---

<div id="asymptote-scene" class="scene-only pointer-events-none absolute inset-0 z-10 overflow-hidden opacity-0" aria-hidden="true">
	<SpaceBackdrop />
	<CartesianPlane />
	<LimitBlock />
	<AsymptoteGlyphs />
	<BurstDots />
	<TravelCaptions />
	<ProjectionLabels />

	<!-- black hole (webgl) crossed in the final stretch: enters from the
	     right, LOW (only the top half pokes through), and the "camera" sails
	     past → drifts left and exits. above it, the asymptote keeps going.
	     the script (intro-scene.ts) positions and animates it.
	     placed BEFORE (below) the asymptote and the community in the dom:
	     its canvas is opaque and square (1400px), it would cover anything left behind it. -->
	<div id="outro-blackhole" class="pointer-events-none fixed left-1/2 top-1/2 opacity-0" aria-hidden="true">
		<BlackHole size={1400} />
	</div>

	<OutroLine />
	<CommunityCarousel />
	<StepsWorld />
	<OutroStar />
	<DiveLayers />
	<SpaceFeatures />
</div>
