---
import BlackHole from "./BlackHole.astro";
import SpaceBackdrop from "./scene/SpaceBackdrop.astro";
import CartesianPlane from "./scene/CartesianPlane.astro";
import LimitBlock from "./scene/LimitBlock.astro";
import AsymptoteGlyphs from "./scene/AsymptoteGlyphs.astro";
import BurstDots from "./scene/BurstDots.astro";
import TravelCaptions from "./scene/TravelCaptions.astro";
import ProjectionLabels from "./scene/ProjectionLabels.astro";
import OutroLine from "./scene/OutroLine.astro";
import CommunityCarousel from "./scene/CommunityCarousel.astro";
import StepsWorld from "./scene/StepsWorld.astro";
import OutroStar from "./scene/OutroStar.astro";
import DiveLayers from "./scene/DiveLayers.astro";
import SpaceFeatures from "./scene/SpaceFeatures.astro";

// Segundo acto de la escena de scroll (ver src/scripts/intro-scene.ts):
//
// 1. Aparece "lim" con "x ⟶ ∞" como subíndice, en el hueco que dejaba el
//    título del hero.
// 2. El título "89K+ Raids bloqueados" se FORMA a partir de la grilla de
//    stats: el script despega el número y la etiqueta REALES de la segunda
//    celda de <Stats/> (no un clon) y los recoloca, ya "formados", debajo
//    del límite. Mientras se recoloca: aparecen más símbolos matemáticos por
//    toda la pantalla, el radar gira un poco más y las otras casillas de
//    stats se separan y caen desvaneciéndose.
// 3. El número se encoge y viaja hasta ocupar la "x" del límite (que se
//    desvanece); la etiqueta "Raids bloqueados" se queda quieta donde estaba.
// 4. Desenlace: el "89K+" se dispara contando hasta un número titánico y el ∞
//    empieza a temblar pronto, cada vez más fuerte. Entonces el ∞ ESTALLA:
//    desaparece y su onda expansiva se lleva por delante el radar, el bloque
//    del límite y el título "89K+ Raids bloqueados" — salen despedidos y se
//    desintegran en partículas azules y blancas que se arrastran hacia fuera.
//    De ese punto estallado emerge el plano cartesiano, un círculo que crece
//    desde el infinito hasta ocupar toda la pantalla, y la curva crece. Solo
//    queda el plano (y los símbolos tenues del fondo). El límite NO crece.
//
// Cada capa vive en su propio componente (src/components/scene/). El ORDEN de
// abajo es el orden del DOM y es importante: es el orden de apilado (por ejemplo,
// el agujero negro va antes que la asíntota y la comunidad porque su canvas es
// opaco) y no debe alterarse sin comprobar la escena.
---

<div id="asymptote-scene" class="scene-only pointer-events-none absolute inset-0 z-10 overflow-hidden opacity-0" aria-hidden="true">
	<SpaceBackdrop />
	<CartesianPlane />
	<LimitBlock />
	<AsymptoteGlyphs />
	<BurstDots />
	<TravelCaptions />
	<ProjectionLabels />

	<!-- Agujero negro (WebGL) que se cruza en el tramo final: entra por la
	     derecha, BAJO (solo asoma la mitad superior), y la "cámara" pasa de
	     largo → deriva a la izquierda y sale. Arriba, la asíntota sigue
	     avanzando. El script (intro-scene.ts) lo posiciona y anima.
	     Va ANTES (debajo) de la asíntota y de la comunidad en el DOM: su canvas
	     es opaco y cuadrado (1400px), taparía todo lo que quedase detrás. -->
	<div id="outro-blackhole" class="pointer-events-none fixed left-1/2 top-1/2 opacity-0" aria-hidden="true">
		<BlackHole size={1400} />
	</div>

	<OutroLine />
	<CommunityCarousel />
	<StepsWorld />
	<OutroStar />
	<DiveLayers />
	<SpaceFeatures />
</div>
