<!-- Notación de límite propiamente dicha: "lim" recto (es un operador, no
     una variable) con "x ⟶ ∞" como subíndice centrado justo debajo. La
     variable va en cursiva serif (convención matemática) y el ∞ lleva un
     leve halo azul que respira, para que enganche con la estética del
     radar. La posición (fixed) la calcula el script a partir del rect real
     del título del hero. #limit-x se mantiene como caja medible: el número
     de "Raids bloqueados" viaja hasta centrarse sobre él. -->
<div id="limit-block" class="text-left opacity-0">
	<div class="inline-flex flex-col items-center">
		<span class="font-display text-text text-[104px] leading-[0.8] font-semibold tracking-[-0.03em]">
			lim
		</span>
		<span class="mt-1 flex items-center gap-2.5 text-[28px] leading-none">
			<span id="limit-x" class="text-text inline-block min-w-[1.2em] text-center font-serif text-[31px] italic">
				x
			</span>
			<span id="limit-arrow" class="text-text-faint text-[23px]">&#10230;</span>
			<span id="limit-infinity-shake" class="limit-infinity-shake inline-block">
				<span class="limit-infinity text-brand text-[35px]">&#8734;</span>
			</span>
		</span>
	</div>
</div>

<!-- El título "89K+ Raids bloqueados" no vive aquí: el script lo forma
     despegando el número y la etiqueta REALES de la segunda celda de
     <Stats/> y recolocándolos debajo del límite. -->


<style>
	/* Halo azul suave sobre el ∞ que respira lentamente — mismo lenguaje
	   visual que el brillo del radar. El script solo toca opacity/scale/x de
	   #limit-block (ancestro), así que esta animación no colisiona. */
	.limit-infinity {
		display: inline-block;
		text-shadow: 0 0 22px color-mix(in oklab, var(--color-brand) 45%, transparent);
		animation: limit-infinity-breathe 4.5s ease-in-out infinite;
	}

	@keyframes limit-infinity-breathe {
		0%,
		100% {
			opacity: 0.82;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.06);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.limit-infinity {
			animation: none;
			opacity: 1;
		}
	}

	/* Temblor del ∞ en el desenlace: la animación corre siempre en tiempo real
	   (no ligada al scroll), pero su amplitud la controla el script subiendo
	   --tremble de 0 a 1. Con --tremble:0 no se mueve. */
	.limit-infinity-shake {
		animation: limit-infinity-shake 130ms steps(2, jump-none) infinite;
	}

	@keyframes limit-infinity-shake {
		0%,
		100% {
			transform: translate(0, 0) rotate(0deg);
		}
		25% {
			transform: translate(calc(var(--tremble, 0) * -1.6px), calc(var(--tremble, 0) * 1.1px))
				rotate(calc(var(--tremble, 0) * -1.4deg));
		}
		50% {
			transform: translate(calc(var(--tremble, 0) * 1.5px), calc(var(--tremble, 0) * -1.3px))
				rotate(calc(var(--tremble, 0) * 1.2deg));
		}
		75% {
			transform: translate(calc(var(--tremble, 0) * -1px), calc(var(--tremble, 0) * -1.5px))
				rotate(calc(var(--tremble, 0) * 0.9deg));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.limit-infinity-shake {
			animation: none;
		}
	}
</style>
