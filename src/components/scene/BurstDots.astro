---
// burst particles: the script scatters them across the ∞, the radar and the
// limit block and fires them outward. alternating blue and white, varied sizes.
const burstDots = Array.from({ length: 26 }, (_, i) => ({
	size: 4 + (i % 4) * 2,
	blue: i % 2 === 0,
}));
---

<!-- burst particles for the ∞ (climax). the script places them over
     the ∞ and fires them toward the edges; they start invisible. -->
<div id="limit-burst" class="pointer-events-none fixed inset-0" aria-hidden="true">
	{
		burstDots.map((d) => (
			<span
				class="limit-burst-dot absolute opacity-0"
				style={`width:${d.size}px; height:${d.size}px; background:${d.blue ? "#0079bb" : "#eeeeee"};`}
			/>
		))
	}
</div>


<style>
	.limit-burst-dot {
		border-radius: 9999px;
		will-change: transform, opacity;
	}
</style>
