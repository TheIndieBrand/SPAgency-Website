	<!-- Luna: entra desde arriba y cruza hasta abajo (sensación de seguir
	     subiendo). Va detrás de todo y a media opacidad → se ve lejana. -->
	<div id="moon" class="absolute top-0 left-1/2 -z-10 -translate-x-1/2 opacity-0 blur-[1px]">
		<svg width="150" height="150" viewBox="0 0 220 220" fill="none">
			<defs>
				<radialGradient id="moonBody" cx="37%" cy="33%" r="78%">
					<stop offset="0%" stop-color="#f6f4ec" />
					<stop offset="46%" stop-color="#d3d6dd" />
					<stop offset="78%" stop-color="#8b909d" />
					<stop offset="100%" stop-color="#565b69" />
				</radialGradient>
				<radialGradient id="moonShade" cx="30%" cy="25%" r="100%">
					<stop offset="0%" stop-color="#05060a" stop-opacity="0" />
					<stop offset="60%" stop-color="#05060a" stop-opacity="0" />
					<stop offset="100%" stop-color="#05060a" stop-opacity="0.6" />
				</radialGradient>
				<radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="#cdd6ff" stop-opacity="0.32" />
					<stop offset="62%" stop-color="#cdd6ff" stop-opacity="0.06" />
					<stop offset="100%" stop-color="#cdd6ff" stop-opacity="0" />
				</radialGradient>
				<radialGradient id="crater" cx="40%" cy="36%" r="70%">
					<stop offset="0%" stop-color="#666c79" />
					<stop offset="55%" stop-color="#969cab" />
					<stop offset="100%" stop-color="#b7bcc7" />
				</radialGradient>
				<clipPath id="moonClip"><circle cx="110" cy="110" r="80" /></clipPath>
			</defs>
			<circle cx="110" cy="110" r="108" fill="url(#moonGlow)" />
			<circle cx="110" cy="110" r="80" fill="url(#moonBody)" />
			<g clip-path="url(#moonClip)">
				<ellipse cx="84" cy="78" rx="16" ry="15" fill="url(#crater)" opacity="0.9" />
				<ellipse cx="134" cy="102" rx="10" ry="9" fill="url(#crater)" opacity="0.85" />
				<ellipse cx="99" cy="143" rx="19" ry="17" fill="url(#crater)" opacity="0.82" />
				<ellipse cx="145" cy="152" rx="7" ry="6.5" fill="url(#crater)" opacity="0.8" />
				<ellipse cx="70" cy="120" rx="6" ry="5.5" fill="url(#crater)" opacity="0.78" />
				<ellipse cx="120" cy="60" rx="5" ry="4.5" fill="url(#crater)" opacity="0.72" />
				<circle cx="150" cy="86" r="26" fill="#ffffff" opacity="0.05" />
				<circle cx="78" cy="150" r="20" fill="#000000" opacity="0.06" />
			</g>
			<circle cx="110" cy="110" r="80" fill="url(#moonShade)" />
			<circle cx="110" cy="110" r="80" fill="none" stroke="#eef0f5" stroke-opacity="0.14" stroke-width="1" />
		</svg>
	</div>
