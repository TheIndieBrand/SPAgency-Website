<svg
	id="asymptote-grid"
	class="absolute inset-0 h-full w-full"
	viewBox="0 0 1000 600"
	preserveAspectRatio="none"
>
	<defs>
		<pattern id="cartesian-cell" width="40" height="40" patternUnits="userSpaceOnUse">
			<path d="M40 0 L0 0 0 40" fill="none" stroke="#0079bb" stroke-opacity="0.16" stroke-width="1"></path>
		</pattern>
	</defs>

	<!-- El script traslada este grupo (cámara-follow) durante el "viaje" por
	     el eje X. La rejilla y los ejes son MUCHO más anchos que el viewBox
	     para no quedarse cortos durante el paneo; terminan hacia x≈5400
	     a propósito, para que el plano "se acabe" en el estallido final. -->
	<g id="asymptote-drift">
		<!-- La rejilla y los ejes (que se apagan en el salto al espacio). La
		     CURVA va aparte, fuera de este grupo, para que no se desvanezca
		     con ella: la función nunca desaparece. -->
		<g id="grid-lines">
			<rect x="-600" y="-600" width="6000" height="2400" fill="url(#cartesian-cell)"></rect>
			<line x1="-600" y1="560" x2="5400" y2="560" stroke="#0079bb" stroke-opacity="0.4" stroke-width="1.5"></line>
			<line x1="40" y1="-600" x2="40" y2="1800" stroke="#0079bb" stroke-opacity="0.4" stroke-width="1.5"></line>
		</g>

		<!-- Curva + proyecciones + punta. Al final el script rota ESTE grupo
		     sobre la propia punta para tumbar la función hacia arriba. -->
		<g id="curve-tilt">
		<!-- curva exponencial: tendida y casi pegada al eje X durante un
		     tramo larguísimo (el "viaje"), luego se dispara casi vertical y
		     SIGUE subiendo sin fin (tramo larguísimo hasta y≈-9000): nunca
		     se termina de dibujar → sensación de crecer hacia el infinito -->
		<path
			id="asymptote-curve"
			d="M 40 558 C 900 553, 1900 543, 2600 520 C 3200 500, 3700 468, 4050 420 C 4300 385, 4480 320, 4600 232 C 4720 150, 4830 10, 4910 -260 C 4980 -520, 5030 -1000, 5060 -1650 C 5085 -2300, 5108 -3600, 5124 -5200 C 5136 -6400, 5144 -7700, 5150 -9000"
			fill="none"
			stroke="#0079bb"
			stroke-width="3"
			stroke-linecap="round"
		></path>

		<!-- proyecciones de la punta a los ejes: vertical roja hasta el eje X
		     (representa x0) y horizontal ámbar hasta el eje Y (representa
		     y0). Finas y punteadas; el script fija sus extremos cada frame. -->
		<g id="curve-proj" opacity="0">
			<line
				id="curve-proj-x"
				x1="0"
				y1="0"
				x2="0"
				y2="0"
				stroke="#ef4444"
				stroke-width="1.3"
				stroke-dasharray="5 5"
				vector-effect="non-scaling-stroke"
			></line>
			<line
				id="curve-proj-y"
				x1="0"
				y1="0"
				x2="0"
				y2="0"
				stroke="#f5b301"
				stroke-width="1.3"
				stroke-dasharray="5 5"
				vector-effect="non-scaling-stroke"
			></line>
		</g>

		<!-- punta de la función: puntito blanco sutil (núcleo + halo). En el
		     tramo "espacio" el script hace crossfade a la estrellita. -->
		<g id="asymptote-curve-head" opacity="0">
			<circle r="8" fill="#eeeeee" opacity="0.08"></circle>
			<circle id="curve-head-dot" r="3" fill="#eeeeee" opacity="0.72"></circle>
			<!-- La estrella va envuelta en su propio <g> (#curve-head-star):
			     el script rota ESE grupo, así gira limpia sobre (0,0). -->
			<g id="curve-head-star" opacity="0">
				<path
					fill="#eeeeee"
					d="M 0 -8 Q 1.5 -1.5 8 0 Q 1.5 1.5 0 8 Q -1.5 1.5 -8 0 Q -1.5 -1.5 0 -8 Z"
				></path>
			</g>
		</g>
		</g>
	</g>
</svg>
