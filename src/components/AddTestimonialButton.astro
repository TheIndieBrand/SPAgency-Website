---
// "add yours": a transparent, dashed-outline button the same width as a
// testimonial card (320px), linking to /testimonios. sits right after the
// last card, both in the scene (CommunityCarousel) and in the simple version (Testimonials).
interface Props {
	class?: string;
	[attr: string]: unknown;
}

const { class: className, ...attrs } = Astro.props;
---

<a
	href="/testimonios"
	class:list={[
		"add-testimonial group text-text-dim hover:border-brand/60 hover:text-brand flex w-[320px] shrink-0 items-center justify-center gap-2 rounded-[14px] border border-dashed border-neutral-700 bg-transparent px-6 py-3.5 text-sm font-semibold transition-colors duration-200",
		className,
	]}
	{...attrs}
>
	<i class="bi bi-plus-lg text-base transition-transform duration-200 group-hover:rotate-90" aria-hidden="true" />
	Agrega el tuyo
</a>
