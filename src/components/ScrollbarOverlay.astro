---
// custom scrollbar for every page except the home page (which has none). the
// native one is hidden and this one is drawn on top: it appears on scroll,
// when the mouse nears the right edge, or while dragging it, and fades out
// on its own after a while. wheel, keyboard and touch scrolling stay the
// document's native scroll; this only draws and allows dragging. the
// data-overlay-scroll attribute is set by Layout before the first paint
// (mouse only: on touch the native one stays, which is already overlaid),
// so removing it causes no layout shift.
---

<div id="scrollbar-overlay" class="sb-track" aria-hidden="true">
	<div class="sb-thumb"></div>
</div>

<style is:global>
	html[data-overlay-scroll] {
		scrollbar-width: none;
	}
	html[data-overlay-scroll]::-webkit-scrollbar {
		display: none;
	}

	/* right-edge strip: invisible and not capturing clicks until shown. */
	.sb-track {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		width: 16px;
		z-index: 60;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.28s ease,
			background-color 0.2s ease;
	}
	.sb-track[data-visible] {
		opacity: 1;
		pointer-events: auto;
	}
	.sb-track[data-none] {
		display: none;
	}
	.sb-track[data-hover],
	.sb-track[data-drag] {
		background-color: rgba(255, 255, 255, 0.035);
	}

	/* thumb: discreet gray; brand blue on hover, brighter while dragging. */
	.sb-thumb {
		position: absolute;
		top: 0;
		right: 3px;
		width: 6px;
		border-radius: 999px;
		background-color: #3d3d3d;
		will-change: transform;
		transition:
			width 0.15s ease,
			background-color 0.15s ease;
	}
	.sb-track[data-hover] .sb-thumb {
		width: 9px;
		background-color: #0079bb;
	}
	.sb-track[data-drag] .sb-thumb {
		width: 9px;
		background-color: #0093e4;
	}

	@media (prefers-reduced-motion: reduce) {
		.sb-track,
		.sb-thumb {
			transition: none;
		}
	}
</style>

<script>
	const root = document.documentElement;
	const track = document.getElementById("scrollbar-overlay");
	const thumb = track?.querySelector<HTMLElement>(".sb-thumb");

	if (track && thumb && root.hasAttribute("data-overlay-scroll")) {
		const HideDelay = 900; // ms visible after the last signal
		const Edge = 28; // px from the right edge that count as "against it"
		const MinThumb = 40;

		let hideTimer = 0;
		let frame = 0;
		let hovering = false;
		let nearEdge = false;
		let dragging = false;

		const scroller = () => document.scrollingElement ?? root;

		const metrics = () => {
			const el = scroller();
			const view = el.clientHeight;
			const max = el.scrollHeight - view;
			const size = Math.max(MinThumb, (view / el.scrollHeight) * view);
			return { el, max, size, free: view - size, view };
		};

		const update = () => {
			frame = 0;
			const m = metrics();
			const scrollable = m.max > 1;
			track.toggleAttribute("data-none", !scrollable);
			if (!scrollable) return;
			thumb.style.height = `${m.size}px`;
			thumb.style.transform = `translateY(${(m.el.scrollTop / m.max) * m.free}px)`;
		};
		const requestUpdate = () => {
			if (!frame) frame = requestAnimationFrame(update);
		};

		const show = () => {
			window.clearTimeout(hideTimer);
			track.setAttribute("data-visible", "");
		};
		const scheduleHide = () => {
			window.clearTimeout(hideTimer);
			hideTimer = window.setTimeout(() => {
				if (!dragging && !hovering && !nearEdge) track.removeAttribute("data-visible");
			}, HideDelay);
		};

		window.addEventListener(
			"scroll",
			() => {
				requestUpdate();
				show();
				scheduleHide();
			},
			{ passive: true },
		);

		// mouse against the right edge: it appears; moving away, it fades out.
		document.addEventListener(
			"mousemove",
			(event) => {
				const near = event.clientX >= window.innerWidth - Edge;
				if (near === nearEdge) return;
				nearEdge = near;
				if (near) {
					update();
					show();
				} else {
					scheduleHide();
				}
			},
			{ passive: true },
		);
		document.documentElement.addEventListener("mouseleave", () => {
			nearEdge = false;
			scheduleHide();
		});

		track.addEventListener("pointerenter", () => {
			hovering = true;
			track.setAttribute("data-hover", "");
			show();
		});
		track.addEventListener("pointerleave", () => {
			hovering = false;
			track.removeAttribute("data-hover");
			scheduleHide();
		});

		// dragging the thumb.
		let startY = 0;
		let startScroll = 0;
		thumb.addEventListener("pointerdown", (event) => {
			event.preventDefault();
			dragging = true;
			startY = event.clientY;
			startScroll = scroller().scrollTop;
			thumb.setPointerCapture(event.pointerId);
			track.setAttribute("data-drag", "");
			document.body.style.userSelect = "none";
		});
		thumb.addEventListener("pointermove", (event) => {
			if (!dragging) return;
			const m = metrics();
			if (m.free <= 0) return;
			m.el.scrollTop = startScroll + ((event.clientY - startY) / m.free) * m.max;
		});
		const endDrag = () => {
			if (!dragging) return;
			dragging = false;
			track.removeAttribute("data-drag");
			document.body.style.userSelect = "";
			scheduleHide();
		};
		thumb.addEventListener("pointerup", endDrag);
		thumb.addEventListener("pointercancel", endDrag);

		// click on the empty track: jumps a page in that direction, like the native one.
		track.addEventListener("pointerdown", (event) => {
			if (event.target !== track) return;
			const m = metrics();
			const above = event.clientY < thumb.getBoundingClientRect().top;
			m.el.scrollBy({ top: (above ? -1 : 1) * m.view * 0.9 });
		});

		window.addEventListener("resize", requestUpdate);
		new ResizeObserver(requestUpdate).observe(document.body);
		requestUpdate();
	}
</script>
