---
// Sección de la versión simple (móvil, reduced-motion, sin JS). Con la escena
// animada, la CTA vive al final de ella (SceneCta.astro): sale del negro tras la
// inmersión en el agujero negro, y esta sección se oculta (static-only, ver
// global.css).
import { cta, labels } from "../lib/home-content";
import { site } from "../lib/site";
---

<section id="cta-static" class="static-only mx-auto max-w-[1180px] px-8 pb-[110px]">
	<div class="border-border bg-bg-soft rounded-xl border px-10 py-16 text-center">
		<h2 class="font-display mb-3.5 text-[34px] font-bold tracking-tight">
			{cta.title}
		</h2>
		<p class="text-text-dim mb-8 text-base">{cta.subtitle}</p>
		<a
			href={site.inviteUrl}
			class="bg-brand hover:bg-brand-hover inline-block rounded-[8px] px-[30px] py-[15px] text-[15px] font-bold text-white transition-colors"
		>
			{labels.inviteFree}
		</a>
	</div>
</section>
