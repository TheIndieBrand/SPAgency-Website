---
import { footerColumns as columns, site } from "../lib/site";
---

<footer id="site-footer" class="border-border-soft border-t">
	<div class="mx-auto grid max-w-[1180px] grid-cols-2 gap-8 px-8 pt-14 pb-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
		<div class="col-span-2 md:col-span-1">
			<div class="mb-3.5 flex items-center gap-2.5">
				<img src="/logo.png" alt={site.name} width="26" height="26" class="h-[26px] w-[26px] rounded-[25%]" />
				<span class="font-display text-base font-bold">{site.name}</span>
			</div>
			<p class="text-text-faint max-w-[240px] text-sm leading-relaxed">
				Seguridad automatizada para comunidades de Discord.
			</p>
		</div>

		{
			columns.map((col) => (
				<div>
					<div class="text-text mb-3.5 text-[13px] font-bold">{col.title}</div>
					<div class="flex flex-col gap-2.5">
						{col.links.map((link) => (
							<a href={link.href} {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="text-text-dim hover:text-brand text-sm font-semibold transition-colors">
								{link.label}
							</a>
						))}
					</div>
				</div>
			))
		}
	</div>
	<div
		class="border-border-soft text-text-faint mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t px-8 py-6 text-[13px]"
	>
		<span>© 2026 {site.name}. Todos los derechos reservados.</span>
		<nav aria-label="Legal" class="flex gap-5">
			<a href={site.termsUrl} class="hover:text-brand transition-colors">Términos del servicio</a>
			<a href={site.privacyUrl} class="hover:text-brand transition-colors">Política de privacidad</a>
		</nav>
	</div>
</footer>

<style is:global>
	/* Con la escena de entrada animada la página termina en el negro del espacio
	   (la CTA sale de él), así que el footer también va en negro: sin costura. */
	[data-scene="on"] #site-footer {
		background: #000;
	}
</style>
