---
interface Props {
	size?: number;
	class?: string;
}

const { size = 220, class: className = "" } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 220 220" class={className}>
	<path
		d="M110 20 L185 46 V102 C185 148 154 182 110 200 C66 182 35 148 35 102 V46 Z"
		fill="none"
		stroke="currentColor"
		stroke-width="4"
		stroke-linejoin="round"
		class="text-text"
	></path>
	<circle cx="110" cy="98" r="16" fill="none" stroke="currentColor" stroke-width="4" class="text-accent"
	></circle>
	<path d="M110 114 L110 132" stroke="currentColor" stroke-width="4" stroke-linecap="round" class="text-accent"
	></path>
</svg>
