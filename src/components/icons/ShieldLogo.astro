---
interface Props {
	size?: number;
	class?: string;
}

const { size = 30, class: className = "" } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 48 48" fill="none" class={className}>
	<rect width="48" height="48" rx="12" class="fill-blue" />
	<path
		d="M24 10 L35 14.5 V23 C35 30.5 30.2 35.8 24 38 C17.8 35.8 13 30.5 13 23 V14.5 Z"
		fill="none"
		stroke="white"
		stroke-width="2.4"
		stroke-linejoin="round"
	></path>
	<circle cx="24" cy="22" r="3.4" fill="none" stroke="white" stroke-width="2.2"></circle>
	<path d="M24 25.4 L24 29.5" stroke="white" stroke-width="2.2" stroke-linecap="round"></path>
</svg>
