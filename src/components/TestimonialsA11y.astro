---
// Versión semántica (solo para lectores de pantalla) de los testimonios que se
// ven en el carrusel de la escena de entrada. Esa escena entera es
// aria-hidden (es presentación), así que sin esto el contenido real no le
// llegaría a nadie que no vea la pantalla. intro-scene.ts la oculta si cae al
// respaldo estático (que ya es accesible por sí mismo).
import { testimonials } from "../lib/testimonials";
---

<section id="testimonials-a11y" class="sr-only" aria-labelledby="testimonials-a11y-title">
	<h2 id="testimonials-a11y-title">Lo que dice la comunidad</h2>
	<ul>
		{
			testimonials.map((t) => (
				<li>
					<blockquote>{t.comment}</blockquote>
					<p>
						{t.username}, {t.role}
					</p>
				</li>
			))
		}
	</ul>
</section>
