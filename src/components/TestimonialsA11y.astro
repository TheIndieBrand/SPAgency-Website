---
// semantic version (screen readers only) of the testimonials shown in the
// intro scene's carousel. that whole scene is aria-hidden (presentation
// only), so without this the actual content would never reach anyone who
// can't see the screen. only exists with the animated scene (scene-only,
// see global.css); the simple version is already accessible on its own.
import { sections } from "../lib/home-content";
import { testimonials } from "../lib/testimonials";
---

<section id="testimonials-a11y" class="scene-only sr-only" aria-labelledby="testimonials-a11y-title">
	<h2 id="testimonials-a11y-title">{sections.testimonials.title}</h2>
	<ul>
		{
			testimonials.map((t) => (
				<li>
					<blockquote>{t.comment}</blockquote>
					<p>
						{t.username}, {t.role}
					</p>
				</li>
			))
		}
	</ul>
</section>
