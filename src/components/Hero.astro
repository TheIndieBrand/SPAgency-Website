---
import SecurityConsole from "./SecurityConsole.astro";
---

<section class="relative mx-auto max-w-[1180px] px-8 pt-24 pb-24">
	<div
		class="pointer-events-none absolute inset-0 -z-10"
		style="background: radial-gradient(60% 55% at 50% 35%, var(--color-navy-glow) 0%, transparent 70%); opacity: 0.08;"
	>
	</div>

	<div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
		<div class="text-left">
			<div
				class="border-border text-text-dim mb-7 inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-[13px] font-semibold"
			>
				<span class="bg-emerald inline-block h-1.5 w-1.5 rounded-full"></span>
				Protección activa 24/7
			</div>

			<h1 class="font-display mb-6 text-[46px] leading-[1.12] font-bold tracking-tight lg:text-[52px]">
				Tu servidor, blindado contra raids en tiempo real.
			</h1>

			<p class="text-text-dim mb-10 max-w-[520px] text-[17px] leading-relaxed">
				SP Agency detecta oleadas de bots, cuentas falsas y ataques coordinados en segundos, y responde
				automáticamente antes de que tu comunidad lo note.
			</p>

			<div class="flex flex-wrap items-center gap-3.5">
				<a
					href="#"
					class="bg-brand hover:bg-brand-hover rounded-[8px] px-[24px] py-3 text-[15px] font-bold text-white transition-colors"
				>
					Añadir a Discord — gratis
				</a>
				<a
					href="#"
					class="border-border hover:border-brand hover:text-brand rounded-[8px] border px-[24px] py-3 text-[15px] font-bold transition-colors"
				>
					Ver documentación
				</a>
			</div>
		</div>

		<SecurityConsole />
	</div>
</section>
