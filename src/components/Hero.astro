---
import { hero, labels } from "../lib/home-content";
import { site } from "../lib/site";
import RadarGrid from "./RadarGrid.astro";

// symbols that fade in and out across the whole Hero (not just the radar),
// very faint, each with its own cycle so they don't all flicker together.
// purely ambient — decorative, not interactive.
//
// `delay` is the fraction of the cycle each one starts at (0–1), applied as
// a NEGATIVE delay: that makes the browser start the animation as if it had
// already been running a while, so on page load every letter is already at
// a different point in its cycle (some visible, others not) instead of all
// starting in sync at 0.
const ambientGlyphs = [
	{ text: "λ", x: 4, y: 12, size: 22, tone: "brand", peak: 0.14, duration: 9, delay: 0.2 },
	{ text: "O(1)", x: 92, y: 8, size: 13, tone: "text", peak: 0.12, duration: 11, delay: 0.5 },
	{ text: "Σ", x: 8, y: 82, size: 24, tone: "brand", peak: 0.13, duration: 10, delay: 0.8 },
	{ text: "∂/∂t", x: 88, y: 88, size: 13, tone: "text", peak: 0.11, duration: 8, delay: 0.35 },
	{ text: "θ", x: 48, y: 6, size: 18, tone: "brand", peak: 0.1, duration: 12, delay: 0.65 },
	{ text: "√n", x: 3, y: 46, size: 15, tone: "text", peak: 0.12, duration: 9.5, delay: 0.1 },
	{ text: "∞", x: 95, y: 48, size: 20, tone: "brand", peak: 0.11, duration: 10.5, delay: 0.9 },
	{ text: "Δt", x: 60, y: 92, size: 14, tone: "text", peak: 0.13, duration: 8.5, delay: 0.45 },
	{ text: "π", x: 34, y: 4, size: 16, tone: "text", peak: 0.1, duration: 11.5, delay: 0.6 },
];
---

<section id="hero" class="relative mx-auto max-w-[1180px] px-8 pt-24 pb-24">
	<div
		class="pointer-events-none absolute inset-0 -z-10"
		style="background: radial-gradient(60% 55% at 50% 35%, var(--color-navy-glow) 0%, transparent 70%); opacity: 0.08;"
	>
	</div>

	<div class="pointer-events-none absolute inset-0 -z-10 font-mono select-none" aria-hidden="true">
		{
			ambientGlyphs.map((g) => (
				<span
					class="animate-glyph-appear absolute leading-none whitespace-nowrap"
					style={`left:${g.x}%; top:${g.y}%; font-size:${g.size}px; color:${g.tone === "brand" ? "#0079bb" : "#eeeeee"}; --glyph-peak:${g.peak}; --glyph-duration:${g.duration}s; animation-delay:${-(g.delay * g.duration).toFixed(2)}s;`}
				>
					{g.text}
				</span>
			))
		}
	</div>

	<div id="hero-content" class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
		<div class="text-left">
			<h1 class="font-display mb-6 text-[46px] leading-[1.12] font-bold tracking-tight lg:text-[52px]">
				{hero.title}
			</h1>

			<p id="hero-subtitle" class="text-text-dim mb-10 max-w-[520px] text-[17px] leading-relaxed">
				{hero.subtitle}
			</p>

			<div id="hero-actions" class="flex flex-wrap items-center gap-3.5">
				<a
					href={site.inviteUrl}
					class="bg-brand hover:bg-brand-hover rounded-[8px] px-[24px] py-3 text-[15px] font-bold text-white transition-colors"
				>
					{labels.invite}
				</a>
				<a
					href={site.docsUrl}
					class="border-border hover:border-brand hover:text-brand rounded-[8px] border px-[24px] py-3 text-[15px] font-bold transition-colors"
				>
					{labels.docs}
				</a>
			</div>
		</div>

		<RadarGrid />
	</div>
</section>
