---
// semantic version (screen readers only) of the six features shown in the
// intro scene's "space" section cards, which is aria-hidden (presentation
// only). only exists with the animated scene (scene-only, see global.css);
// the simple version (Features) is already accessible on its own.
import { features, sections } from "../lib/home-content";
---

<section id="features-a11y" class="scene-only sr-only" aria-labelledby="features-a11y-title">
	<h2 id="features-a11y-title">{sections.features.title}</h2>
	<p>{sections.features.subtitle}</p>
	<ul>
		{
			features.map((f) => (
				<li>
					<strong>{f.title}.</strong> {f.desc}
				</li>
			))
		}
	</ul>
</section>
