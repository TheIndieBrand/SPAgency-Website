---
import Navbar from "../Navbar.astro";
import type { DiscordGuild } from "../../lib/discord";
import { guildIconUrl } from "../../lib/discord";

export type DashboardSection = "general" | "antiraid" | "automod" | "alerts" | "settings" | "logs";

interface Props {
	guild: DiscordGuild;
	active: DashboardSection;
	title: string;
	subtitle?: string;
	raidmodeActive?: boolean;
}

const { guild, active, title, subtitle, raidmodeActive = false } = Astro.props;
const icon = guildIconUrl(guild);
const base = `/dashboard/${guild.id}`;


// Dos grupos separados por una línea, sin rótulos: lo del servidor y lo que se configura.
const groups = [
	[
		{ key: "general" as const, label: "General", href: base, icon: "bi-grid" },
		{ key: "logs" as const, label: "Registros", href: `${base}/logs`, icon: "bi-journal-text" },
	],
	[
		{ key: "antiraid" as const, label: "Anti-Raid & Bots", href: `${base}/antiraid`, icon: "bi-shield-check" },
		{ key: "automod" as const, label: "Automoderación", href: `${base}/automod`, icon: "bi-funnel" },
		{ key: "alerts" as const, label: "Alertas y canales", href: `${base}/alerts`, icon: "bi-bell" },
		{ key: "settings" as const, label: "Ajustes", href: `${base}/settings`, icon: "bi-gear" },
	],
];
const allItems = groups.flat();
---

<div class="bg-bg min-h-screen">
	<Navbar />

	<div class="mx-auto flex max-w-[1400px] items-start">
		<!-- ============ SIDEBAR ============ -->
		<aside class="border-border-soft sticky top-[73px] hidden h-[calc(100vh-73px)] w-60 shrink-0 flex-col overflow-y-auto border-r px-3 py-5 md:flex">
			<div class="mb-5 flex items-center gap-3 px-2">
				{
					icon ? (
						<img src={icon} alt="" class="h-10 w-10 shrink-0 rounded-xl object-cover" />
					) : (
						<div class="bg-brand-soft text-brand-hover flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-base font-bold">
							{guild.name.charAt(0).toUpperCase()}
						</div>
					)
				}
				<div class="min-w-0">
					<div class="text-text truncate text-sm font-bold" title={guild.name}>{guild.name}</div>
					{
						raidmodeActive ? (
							<span class="mt-0.5 inline-flex items-center gap-1.5 text-xs font-semibold text-[#ef4444]">
								<span class="inline-block h-1.5 w-1.5 rounded-full bg-[#ef4444]" />
								Modo Pánico activo
							</span>
						) : (
							<a href="/dashboard" class="text-text-faint hover:text-brand mt-0.5 inline-flex items-center gap-1 text-xs transition-colors">
								<i class="bi bi-arrow-left-short -ml-1 text-sm" />Cambiar de servidor
							</a>
						)
					}
				</div>
			</div>

			<nav class="flex flex-col">
				{
					groups.map((group, i) => (
						<div class:list={["flex flex-col gap-0.5", i > 0 && "border-border-soft mt-3 border-t pt-3"]}>
							{group.map((item) => (
								<a
									href={item.href}
									aria-current={active === item.key ? "page" : undefined}
									class:list={[
										"relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors",
										active === item.key
											? "bg-bg-soft text-text before:bg-brand font-semibold before:absolute before:top-2 before:bottom-2 before:left-0 before:w-0.5 before:rounded-full"
											: "text-text-dim hover:bg-bg-soft/60 hover:text-text font-medium",
									]}
								>
									<i class:list={[`bi ${item.icon} text-[15px]`, active === item.key ? "text-brand" : "text-text-faint"]} />
									{item.label}
								</a>
							))}
						</div>
					))
				}
			</nav>
		</aside>

		<!-- ============ MOBILE NAV ============ -->
		<nav class="border-border-soft scrollbar-none flex w-full gap-2 overflow-x-auto border-b px-4 py-3 md:hidden">
			<span class="text-text border-border flex shrink-0 items-center gap-2 border-r pr-3 text-xs font-bold whitespace-nowrap">
				{icon ? <img src={icon} alt="" class="h-5 w-5 rounded-full object-cover" /> : <i class="bi bi-hdd-network text-text-faint" />}
				{guild.name}
				{raidmodeActive && <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#ef4444]" title="Modo Pánico activo" />}
			</span>
			{
				allItems.map((item) => (
					<a
						href={item.href}
						class:list={[
							"shrink-0 rounded-full px-3 py-1.5 text-xs font-bold whitespace-nowrap transition-colors",
							active === item.key ? "border-brand/50 bg-brand/10 text-brand border" : "border-border text-text-dim border",
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<!-- ============ MAIN CONTENT ============ -->
		<main class="dash-fade min-w-0 flex-1 p-6">
			<div class="mb-6">
				<h1 class="font-display text-2xl font-bold tracking-tight">{title}</h1>
				{subtitle && <p class="text-text-faint mt-1 text-sm">{subtitle}</p>}
			</div>
			<div id="settings-root" data-guild={guild.id}>
				<slot />
			</div>
		</main>
	</div>
</div>

<script>
	import "../../scripts/dashboard-settings";
</script>

<style>
	/* Al llegar desde la carga esquemática de /dashboard, el contenido real entra con
	   un fundido corto en vez de aparecer de golpe. */
	.dash-fade {
		animation: dash-fade 0.3s ease-out both;
	}

	@keyframes dash-fade {
		from {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dash-fade {
			animation: none;
		}
	}
</style>
