---
interface Props {
	name: string;
	label: string;
	description?: string;
	checked?: boolean;
	danger?: boolean;
	disabled?: boolean;
}

const { name, label, description, checked = false, danger = false, disabled = false } = Astro.props;
---

<label class:list={["flex items-center justify-between gap-4 py-3.5 first:pt-0 last:pb-0", disabled ? "cursor-not-allowed opacity-50" : "cursor-pointer"]}>
	<div class="min-w-0">
		<div class="text-text text-sm font-semibold">{label}</div>
		{description && <div class="text-text-faint text-xs">{description}</div>}
	</div>
	<input type="checkbox" name={name} checked={checked} disabled={disabled} class="peer sr-only" />
	<div
		class:list={[
			"relative h-6 w-11 shrink-0 rounded-full transition-colors peer-checked:[&>div]:translate-x-5",
			"bg-border-soft",
			danger ? "peer-checked:bg-[#ef4444]" : "peer-checked:bg-brand",
		]}
	>
		<div class="absolute top-0.5 left-0.5 h-5 w-5 rounded-full bg-white transition-transform" />
	</div>
</label>
