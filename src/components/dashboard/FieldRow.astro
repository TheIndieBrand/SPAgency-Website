---
interface Props {
	label: string;
	description?: string;
}

const { label, description } = Astro.props;
---

<div class="flex flex-col gap-2 py-3.5 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
	<div class="min-w-0 sm:max-w-[60%]">
		<div class="text-text text-sm font-semibold">{label}</div>
		{description && <div class="text-text-faint text-xs">{description}</div>}
	</div>
	<div class="shrink-0">
		<slot />
	</div>
</div>
