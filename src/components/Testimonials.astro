---
// Sección estática de RESPALDO. Con animación, los testimonios se ven en el
// carrusel final de la escena de entrada (AsymptoteScene.astro), así que esta
// sección arranca oculta; intro-scene.ts la muestra solo cuando no hay escena
// animada (prefers-reduced-motion o algo no cargó). Los datos viven en
// src/lib/testimonials.ts.
//
// Las tarjetas corren en dos filas tipo marquee (fila 1 → izquierda, fila 2
// → derecha). Se reparten automáticamente entre las dos filas, no hace falta
// tocar nada más al agregar o quitar testimonios.
import TestimonialCard from "./TestimonialCard.astro";
import { testimonials } from "../lib/testimonials";

const half = Math.ceil(testimonials.length / 2);
const row1 = testimonials.slice(0, half);
const row2 = testimonials.slice(half);
---

<section id="testimonials-static" class="group hidden pt-5 pb-[110px]">
	<div class="mx-auto mb-14 max-w-[560px] px-8 text-center">
		<div class="text-text-faint mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase">Testimonios</div>
		<h2 class="font-display text-[38px] font-bold tracking-tight">Lo que dice la comunidad</h2>
	</div>

	<div class="relative mx-auto max-w-7xl overflow-hidden">
		<div class="from-bg pointer-events-none absolute top-0 left-0 z-10 h-full w-24 bg-gradient-to-r to-transparent">
		</div>
		<div class="from-bg pointer-events-none absolute top-0 right-0 z-10 h-full w-24 bg-gradient-to-l to-transparent">
		</div>

		<div class="animate-marquee-left group-hover:[animation-play-state:paused] mb-5 flex w-max gap-5">
			{row1.map((t) => <TestimonialCard testimonial={t} />)}
			{row1.map((t) => <TestimonialCard testimonial={t} />)}
		</div>

		<div class="animate-marquee-right group-hover:[animation-play-state:paused] flex w-max gap-5">
			{row2.map((t) => <TestimonialCard testimonial={t} />)}
			{row2.map((t) => <TestimonialCard testimonial={t} />)}
		</div>
	</div>
</section>
