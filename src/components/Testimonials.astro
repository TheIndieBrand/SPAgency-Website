---
// section for the simple version (mobile, reduced-motion, no js). with the
// animated scene, testimonials show up in the intro scene's final carousel
// (AsymptoteScene.astro) and this section is hidden (static-only, see
// global.css). the data lives in src/lib/testimonials.ts.
//
// cards run in two marquee-style rows (row 1 → left, row 2 → right). they're
// split between the two rows automatically, nothing else needs touching
// when adding or removing testimonials. under prefers-reduced-motion there's
// no marquee: all cards show, in rows that wrap to the available width.
import AddTestimonialButton from "./AddTestimonialButton.astro";
import TestimonialCard from "./TestimonialCard.astro";
import { sections } from "../lib/home-content";
import { testimonials } from "../lib/testimonials";

const copy = sections.testimonials;
const half = Math.ceil(testimonials.length / 2);
const row1 = testimonials.slice(0, half);
const row2 = testimonials.slice(half);
---

<section id="testimonials-static" class="static-only group pt-5 pb-[110px]">
	<div class="mx-auto mb-14 max-w-[560px] px-8 text-center">
		<div class="text-text-faint mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase">{copy.eyebrow}</div>
		<h2 class="font-display text-[38px] font-bold tracking-tight">{copy.title}</h2>
	</div>

	<div class="relative mx-auto max-w-7xl overflow-hidden">
		<div class="marquee-fade from-bg pointer-events-none absolute top-0 left-0 z-10 h-full w-24 bg-gradient-to-r to-transparent">
		</div>
		<div class="marquee-fade from-bg pointer-events-none absolute top-0 right-0 z-10 h-full w-24 bg-gradient-to-l to-transparent">
		</div>

		<!-- the second copy of each row only exists to make the loop continuous:
		     it's aria-hidden (otherwise screen readers would read every
		     testimonial twice) and hidden under prefers-reduced-motion (see global.css). -->
		<div class="marquee-row animate-marquee-left group-hover:[animation-play-state:paused] mb-5 flex w-max gap-5">
			{row1.map((t) => <TestimonialCard testimonial={t} />)}
			<div class="marquee-dup contents" aria-hidden="true">
				{row1.map((t) => <TestimonialCard testimonial={t} />)}
			</div>
		</div>

		<div class="marquee-row animate-marquee-right group-hover:[animation-play-state:paused] flex w-max gap-5">
			{row2.map((t) => <TestimonialCard testimonial={t} />)}
			<div class="marquee-dup contents" aria-hidden="true">
				{row2.map((t) => <TestimonialCard testimonial={t} />)}
			</div>
		</div>
	</div>

	<!-- right below the last card: links to /testimonios, where anyone with a
	     discord session can leave their own (approved by staff). -->
	<div class="mt-9 flex justify-center px-8">
		<AddTestimonialButton />
	</div>
</section>
