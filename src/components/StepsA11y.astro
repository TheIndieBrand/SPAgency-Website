---
// Versión semántica (solo para lectores de pantalla) de los tres pasos que se
// ven dentro de la escena de entrada, que es aria-hidden (presentación).
// Solo existe con la escena animada (scene-only, ver global.css); la versión
// simple (HowItWorks) ya es accesible por sí misma.
import { steps } from "../lib/steps";
---

<section id="steps-a11y" class="scene-only sr-only" aria-labelledby="steps-a11y-title">
	<h2 id="steps-a11y-title">Cómo funciona: configurado en tres pasos</h2>
	<ol>
		{
			steps.map((s) => (
				<li>
					<strong>{s.title}.</strong> {s.desc}
				</li>
			))
		}
	</ol>
</section>
