---
// semantic version (screen readers only) of the three steps shown inside the
// intro scene, which is aria-hidden (presentation only). only exists with
// the animated scene (scene-only, see global.css); the simple version
// (HowItWorks) is already accessible on its own.
import { steps } from "../lib/steps";
---

<section id="steps-a11y" class="scene-only sr-only" aria-labelledby="steps-a11y-title">
	<h2 id="steps-a11y-title">Cómo funciona: configurado en tres pasos</h2>
	<ol>
		{
			steps.map((s) => (
				<li>
					<strong>{s.title}.</strong> {s.desc}
				</li>
			))
		}
	</ol>
</section>
