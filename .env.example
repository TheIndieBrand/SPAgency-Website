# Copia este archivo a `.env` y rellena los valores. `.env` no se sube a git.

# ── Servidor ────────────────────────────────────────────────────────────────
# Puerto en el que escucha la web (dev: astro dev / prod: server.mjs).
PORT="4321"

# ── Discord (login y dashboard) ─────────────────────────────────────────────
# Credenciales de la aplicación de Discord (Developer Portal → OAuth2).
DISCORD_CLIENT_ID="application_id"
DISCORD_CLIENT_SECRET="oauth2_client_secret"
# Tiene que coincidir con uno de los Redirects registrados en la aplicación.
DISCORD_REDIRECT_URI="http://localhost:4321/auth/discord/callback"
# Token del bot: sirve para saber en qué servidores está SP Agency.
DISCORD_BOT_TOKEN="bot_token"
# Nombre de la cookie de sesión (opcional, por defecto "spa_session").
SESSION_COOKIE_NAME="spa_session"

# ── Changelog ───────────────────────────────────────────────────────────────
# ID de Discord de la única cuenta que puede crear, editar y borrar entradas.
# Si no se define, nadie puede escribir.
CHANGELOG_OWNER_ID="discord_user_id"
# Archivo SQLite del changelog (opcional, por defecto data/changelog.db).
# En producción, apúntalo a un disco que persista.
# CHANGELOG_DB_PATH="data/changelog.db"

# ── Comunicación con el bot (soporte; ver docs/support.md) ───────────────────
# API del bot; escucha solo en 127.0.0.1.
BOT_API_URL="http://127.0.0.1:4501"
# Clave compartida entre la web y el bot, en ambos sentidos: la web la manda al
# llamar a la API del bot y el bot al entregar transcripts a la web. Larga y
# aleatoria; la MISMA que INTERNAL_API_KEY en el .env del bot.
INTERNAL_API_KEY="a long random string"
# Archivo SQLite de los transcripts (opcional, por defecto data/support.db).
# Se guardan para siempre: en producción, apúntalo a un disco que persista.
# SUPPORT_DB_PATH="data/support.db"

# ── Verificación de miembros (ver docs/verification.md) ─────────────────────
# Captcha de Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile →
# Add widget). Sin las dos claves la verificación no se ofrece (falla cerrado).
# Para probar en local, Cloudflare da claves de prueba que siempre pasan:
#   TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# ── Asistente de IA (ver docs/assistant.md) ─────────────────────────────────
# Clave de la API de DeepSeek (https://platform.deepseek.com). Sin ella el
# asistente aparece como "no disponible".
DEEPSEEK_API_KEY="sk-..."
# Opcionales. La API de DeepSeek es compatible con la de OpenAI, así que basta
# con cambiar la URL y el modelo para usar otro proveedor compatible.
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# CHAT_MODEL="deepseek-chat"
# Límite diario por usuario, en unidades ponderadas (ver src/lib/chat/usage.ts).
# CHAT_DAILY_TOKEN_LIMIT="100000"
# IDs de Discord del staff (separados por comas): pueden leer y borrar las
# conversaciones del asistente en /staff/chat. Sin definir, nadie puede.
STAFF_IDS="discord_user_id,otro_discord_user_id"
# Archivo SQLite de las conversaciones (opcional, por defecto data/chat.db). Se
# guardan para siempre: en producción, apúntalo a un disco que persista.
# CHAT_DB_PATH="data/chat.db"
# Carpeta con la web en Markdown (la genera `pnpm knowledge`; opcional).
# KNOWLEDGE_DIR="knowledge"

# ── Base de datos de SP Agency (Postgres) ───────────────────────────────────
# La misma base que usa el bot: la web lee la configuración y los registros y
# actualiza los ajustes. Usa el rol `spagency_web`, que solo tiene SELECT,
# UPDATE de configuración y el INSERT mínimo para crear las filas de un servidor
# (nada de DELETE ni DDL: las migraciones las lleva el bot). En producción la web comparte VPS con Postgres, que solo
# escucha en localhost:
#   postgres://spagency_web:CONTRASEÑA@127.0.0.1:5432/spagency
# En desarrollo se entra por túnel SSH, sin exponer el puerto:
#   ssh -N -L 15432:127.0.0.1:5432 usuario@vps   →   ...@127.0.0.1:15432/spagency
DATABASE_URL="postgres://spagency_web:password@127.0.0.1:5432/spagency"
